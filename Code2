def analyze_significant_zones_multi_timeframe(results_dict, price_bin_size=10.0):
    """
    Analyzes ALL timeframes to identify the most significant zones and prices.
    Returns consolidated zones with importance scores across timeframes.
    """
    print("\n" + "="*80)
    print("ADVANCED MULTI-TIMEFRAME ZONE ANALYSIS")
    print("="*80)
    
    all_zones = []
    
    # Analyze each timeframe
    for tf_name, tf_data in [
        ('1m', results_dict.get('agg1m')),
        ('5m', results_dict.get('agg5m')),
        ('15m', results_dict.get('agg15m')),
        ('1h', results_dict.get('agg1h')),
        ('4h', results_dict.get('agg4h'))
    ]:
        if tf_data is None or tf_data.empty:
            continue
        
        print(f"\n🔍 Analyzing {tf_name} timeframe...")
        
        df = tf_data.copy()
        df['price_zone'] = (df['close'] // price_bin_size) * price_bin_size
        
        # Aggregate by zone
        zone_agg = df.groupby('price_zone').agg({
            'buy_vol': 'sum',
            'sell_vol': 'sum',
            'buy_value': 'sum',
            'sell_value': 'sum',
            'volume': 'sum',
            'OFI': 'mean',
            'CVD': 'last',
            'buyer_score_ewm': 'mean',
            'seller_score_ewm': 'mean',
            'close': ['min', 'max', 'count']
        }).reset_index()
        
        # Flatten column names
        zone_agg.columns = ['price_zone', 'buy_vol', 'sell_vol', 'buy_value', 'sell_value', 
                            'volume', 'OFI', 'CVD', 'buyer_score', 'seller_score',
                            'price_min', 'price_max', 'touch_count']
        
        # Calculate zone metrics
        zone_agg['timeframe'] = tf_name
        zone_agg['total_value'] = zone_agg['buy_value'] + zone_agg['sell_value']
        zone_agg['net_flow'] = zone_agg['buy_value'] - zone_agg['sell_value']
        zone_agg['buy_pressure'] = zone_agg['buy_value'] / (zone_agg['total_value'] + 1e-9)
        zone_agg['dominance'] = zone_agg['buy_vol'] - zone_agg['sell_vol']
        
        all_zones.append(zone_agg)
        print(f"  ✓ Found {len(zone_agg)} zones")
    
    if not all_zones:
        return pd.DataFrame()
    
    # Combine all timeframes
    combined_zones = pd.concat(all_zones, ignore_index=True)
    
    print(f"\n✓ Total zone records across timeframes: {len(combined_zones)}")
    
    # Aggregate across timeframes for each price zone
    print("\n📊 Consolidating zones across timeframes...")
    
    final_zones = combined_zones.groupby('price_zone').agg({
        'buy_vol': 'sum',
        'sell_vol': 'sum',
        'buy_value': 'sum',
        'sell_value': 'sum',
        'volume': 'sum',
        'OFI': 'mean',
        'CVD': 'last',
        'buyer_score': 'mean',
        'seller_score': 'mean',
        'touch_count': 'sum',
        'timeframe': lambda x: ','.join(x.unique())
    }).reset_index()
    
    # Calculate final metrics
    final_zones['total_value'] = final_zones['buy_value'] + final_zones['sell_value']
    final_zones['net_flow'] = final_zones['buy_value'] - final_zones['sell_value']
    final_zones['buy_pressure_ratio'] = final_zones['buy_value'] / (final_zones['total_value'] + 1e-9)
    final_zones['dominance'] = final_zones['buy_vol'] - final_zones['sell_vol']
    
    # Calculate importance score (multi-factor)
    final_zones['volume_score'] = (final_zones['volume'] - final_zones['volume'].min()) / (final_zones['volume'].max() - final_zones['volume'].min() + 1e-9)
    final_zones['value_score'] = (final_zones['total_value'] - final_zones['total_value'].min()) / (final_zones['total_value'].max() - final_zones['total_value'].min() + 1e-9)
    final_zones['touch_score'] = (final_zones['touch_count'] - final_zones['touch_count'].min()) / (final_zones['touch_count'].max() - final_zones['touch_count'].min() + 1e-9)
    final_zones['buyer_score_norm'] = (final_zones['buyer_score'] - final_zones['buyer_score'].min()) / (final_zones['buyer_score'].max() - final_zones['buyer_score'].min() + 1e-9)
    final_zones['seller_score_norm'] = (final_zones['seller_score'] - final_zones['seller_score'].min()) / (final_zones['seller_score'].max() - final_zones['seller_score'].min() + 1e-9)
    
    # Composite importance score
    final_zones['importance_score'] = (
        0.30 * final_zones['volume_score'] +
        0.30 * final_zones['value_score'] +
        0.20 * final_zones['touch_score'] +
        0.10 * final_zones['buyer_score_norm'] +
        0.10 * final_zones['seller_score_norm']
    )
    
    # Categorize zones
    def categorize_zone(row):
        if row['buy_pressure_ratio'] >= 0.65:
            return 'STRONG_BUY'
        elif row['buy_pressure_ratio'] >= 0.55:
            return 'MODERATE_BUY'
        elif row['buy_pressure_ratio'] <= 0.35:
            return 'STRONG_SELL'
        elif row['buy_pressure_ratio'] <= 0.45:
            return 'MODERATE_SELL'
        else:
            return 'NEUTRAL'
    
    final_zones['zone_type'] = final_zones.apply(categorize_zone, axis=1)
    
    # Sort by importance
    final_zones = final_zones.sort_values('importance_score', ascending=False)
    
    print(f"✓ Consolidated into {len(final_zones)} unique price zones")
    
    return final_zones

def identify_key_levels(zones_df, top_n=10):
    """
    Identifies the most critical support and resistance levels.
    """
    print("\n" + "="*80)
    print("IDENTIFYING KEY SUPPORT & RESISTANCE LEVELS")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        return {
            'top_support': pd.DataFrame(),
            'top_resistance': pd.DataFrame(),
            'high_volume_zones': pd.DataFrame(),
            'high_value_zones': pd.DataFrame(),
            'reversal_zones': pd.DataFrame()
        }
    
    df = zones_df.copy()
    
    # 1. Top Support Levels (Strong Buy Zones)
    support = df[df['zone_type'].str.contains('BUY', na=False)].nlargest(top_n, 'importance_score')
    print(f"\n✓ Top {len(support)} Support Levels (Buy Zones)")
    
    # 2. Top Resistance Levels (Strong Sell Zones)
    resistance = df[df['zone_type'].str.contains('SELL', na=False)].nlargest(top_n, 'importance_score')
    print(f"✓ Top {len(resistance)} Resistance Levels (Sell Zones)")
    
    # 3. High Volume Zones (most traded)
    high_volume = df.nlargest(top_n, 'volume')
    print(f"✓ Top {len(high_volume)} High Volume Zones")
    
    # 4. High Value Zones (most dollar flow)
    high_value = df.nlargest(top_n, 'total_value')
    print(f"✓ Top {len(high_value)} High Value Zones")
    
    # 5. Potential Reversal Zones (neutral with high activity)
    reversal = df[df['zone_type'] == 'NEUTRAL'].nlargest(top_n, 'importance_score')
    print(f"✓ Top {len(reversal)} Potential Reversal Zones")
    
    return {
        'top_support': support,
        'top_resistance': resistance,
        'high_volume_zones': high_volume,
        'high_value_zones': high_value,
        'reversal_zones': reversal
    }

def analyze_price_magnets(zones_df, results_dict):
    """
    Identifies price magnets - levels that repeatedly attract price action.
    """
    print("\n" + "="*80)
    print("ANALYZING PRICE MAGNETS & ATTRACTION ZONES")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        return pd.DataFrame()
    
    df = zones_df.copy()
    
    # Calculate magnet strength (combination of touches, volume, and reversion)
    df['magnet_strength'] = (
        0.40 * df['touch_score'] +
        0.30 * df['volume_score'] +
        0.30 * (1 - (df['buy_pressure_ratio'] - 0.5).abs() * 2)  # Higher for neutral zones
    )
    
    # Identify magnets
    magnet_threshold = df['magnet_strength'].quantile(0.80)
    magnets = df[df['magnet_strength'] >= magnet_threshold].copy()
    
    # Add session alignment
    magnets['aligned_with_buyers'] = magnets['buyer_score'] > magnets['seller_score']
    magnets['aligned_with_sellers'] = magnets['seller_score'] > magnets['buyer_score']
    
    magnets = magnets.sort_values('magnet_strength', ascending=False)
    
    print(f"✓ Identified {len(magnets)} price magnet zones")
    print(f"  • Buyer-aligned magnets: {magnets['aligned_with_buyers'].sum()}")
    print(f"  • Seller-aligned magnets: {magnets['aligned_with_sellers'].sum()}")
    
    return magnets

def create_zone_hierarchy(zones_df):
    """
    Creates a hierarchical view of zones by importance.
    """
    print("\n" + "="*80)
    print("CREATING ZONE HIERARCHY")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        return pd.DataFrame()
    
    df = zones_df.copy()
    
    # Define tiers based on importance score
    importance_q66 = df['importance_score'].quantile(0.66)
    importance_q33 = df['importance_score'].quantile(0.33)
    
    def assign_tier(score):
        if score >= importance_q66:
            return 'TIER_1_CRITICAL'
        elif score >= importance_q33:
            return 'TIER_2_IMPORTANT'
        else:
            return 'TIER_3_MINOR'
    
    df['tier'] = df['importance_score'].apply(assign_tier)
    
    # Count by tier and type
    hierarchy = df.groupby(['tier', 'zone_type']).agg({
        'price_zone': 'count',
        'volume': 'sum',
        'total_value': 'sum',
        'importance_score': 'mean'
    }).reset_index()
    
    hierarchy.columns = ['tier', 'zone_type', 'zone_count', 'total_volume', 'total_value', 'avg_importance']
    
    print("\n📊 Zone Hierarchy:")
    for tier in ['TIER_1_CRITICAL', 'TIER_2_IMPORTANT', 'TIER_3_MINOR']:
        tier_data = hierarchy[hierarchy['tier'] == tier]
        if not tier_data.empty:
            print(f"\n  {tier}:")
            for _, row in tier_data.iterrows():
                print(f"    • {row['zone_type']}: {int(row['zone_count'])} zones, "
                      f"Volume: {row['total_volume']:,.0f}, "
                      f"Value: ${row['total_value']:,.0f}")
    
    return df

