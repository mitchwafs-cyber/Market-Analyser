def compute_zone_stats(df, bin_size=BIN_SIZE):
    df_zone = df.copy()
    if 'price' not in df_zone.columns:
        return pd.DataFrame()
    df_zone.loc[:, 'price_zone'] = (df_zone['price'] // bin_size) * bin_size
    grouped = df_zone.groupby('price_zone').agg(
        total_buy_vol=('buy_vol','sum'),
        total_sell_vol=('sell_vol','sum'),
        total_buy_value=('buy_value','sum'),
        total_sell_value=('sell_value','sum'),
        trades=('quantity','count'),
        first_time=('timestamp','min'),
        last_time=('timestamp','max'),
        price_min=('price','min'),  # Add exact minimum price in zone
        price_max=('price','max')   # Add exact maximum price in zone
    )
    grouped['total_vol'] = grouped['total_buy_vol'] + grouped['total_sell_vol']
    grouped['buy_imbalance_pct'] = 100 * grouped['total_buy_vol'] / grouped['total_vol'].replace(0, np.nan)
    return grouped.sort_values('total_buy_value', ascending=False)

# -----------------------
# Helper: add microstructure features to agg frame (shared)
# -----------------------
def add_micro_features(a):
    """
    Add ATD, ATVD, VASP, VSB, burst, SIR, TCP, MLS for both buy and sell sides.
    a: agg (15m) DataFrame indexed by timestamp
    """
    a = a.copy()

    # Basic ATD and normalized version (taker-side delta in volume)
    a.loc[:, 'ATD'] = a['buy_vol'] - a['sell_vol']   # positive => buy-dominant
    a.loc[:, 'ATD_norm'] = a['ATD'] / (a['total_vol'] + 1e-9)

    # Aggressive Taker-Side Value Delta (ATVD) - NEW
    a.loc[:, 'ATVD'] = a['buy_value'] - a['sell_value']
    a.loc[:, 'ATVD_norm'] = a['ATVD'] / (a['buy_value'] + a['sell_value'] + 1e-9)
    a.loc[:, 'ATVD_vol_adj'] = a['ATVD'] / (a['volatility_trade'] + 1e-9)

    # volatility-adjusted ATD (use agg volatility_trade if available)
    a.loc[:, 'ATD_vol_adj'] = a['ATD'] / (a['volatility_trade'] + 1e-9)

    # Volatility-Adjusted Sell/Buy Pressure (VASP)
    a.loc[:, 'VASP_sell'] = a['sell_value'] / (a['volatility_trade'] + 1e-9)
    a.loc[:, 'VASP_buy'] = a['buy_value'] / (a['volatility_trade'] + 1e-9)

    # Burst: speed relative to long-term mean (short / long windows)
    a.loc[:, 'buy_speed'] = (a['buy_vol'] / a['mean_dt'].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    a.loc[:, 'sell_speed'] = (a['sell_vol'] / a['mean_dt'].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    a.loc[:, 'buy_speed_long_mean'] = a['buy_speed'].rolling(W_LONG, min_periods=1).mean()
    a.loc[:, 'sell_speed_long_mean'] = a['sell_speed'].rolling(W_LONG, min_periods=1).mean()

    a.loc[:, 'buy_burst'] = a['buy_speed'] / (a['buy_speed_long_mean'] + 1e-9)
    a.loc[:, 'sell_burst'] = a['sell_speed'] / (a['sell_speed_long_mean'] + 1e-9)

    # Volatility-Adjusted Sell Burst (VSB) - NEW
    a.loc[:, 'VSB'] = a['sell_speed'] / (a['volatility_trade'] + 1e-9)
    a.loc[:, 'VSB_buy'] = a['buy_speed'] / (a['volatility_trade'] + 1e-9)

    # Sell/Buy Imbalance Ratio (SIR)
    a.loc[:, 'SIR_sell'] = a['sell_vol'] / (a['buy_vol'] + 1e-9)
    a.loc[:, 'SIR_buy'] = a['buy_vol'] / (a['sell_vol'] + 1e-9)

    # Trade-Count Pressure (TCP) = volume per trade (captures many small sells)
    a.loc[:, 'TCP_sell'] = a['sell_vol'] / (a['trade_count'] + 1e-9)
    a.loc[:, 'TCP_buy'] = a['buy_vol'] / (a['trade_count'] + 1e-9)

    # Micro Liquidity Stress (MLS): price move over sell volume
    a.loc[:, 'MLS_sell'] = (a['close'] - a['open']).abs() / (a['sell_vol'] + 1e-9)
    a.loc[:, 'MLS_buy'] = (a['close'] - a['open']).abs() / (a['buy_vol'] + 1e-9)

    # Fill inf/nans
    a = a.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return a


# -----------------------
# TIER 1: VPIN (Volume-Synchronized Probability of Informed Trading)
# -----------------------

def calculate_vpin(df, bucket_size=50):
    """
    Calculate VPIN (Volume-Synchronized Probability of Informed Trading).
    Measures order flow toxicity by analyzing volume imbalance in volume buckets.
    
    VPIN = Average|OrderImbalance| / TotalVolume
    
    Returns DataFrame with VPIN metrics per volume bucket.
    """
    df = df.copy()
    
    if 'quantity' not in df.columns or 'buy_vol' not in df.columns or 'sell_vol' not in df.columns:
        return pd.DataFrame({'vpin': [0.0], 'bucket_id': [0], 'volume_imbalance': [0.0]})
    
    # Create volume buckets
    df['cumulative_volume'] = df['quantity'].cumsum()
    total_volume = df['cumulative_volume'].iloc[-1] if len(df) > 0 else 0
    
    if total_volume == 0:
        return pd.DataFrame({'vpin': [0.0], 'bucket_id': [0], 'volume_imbalance': [0.0]})
    
    # Assign bucket IDs
    df['bucket_id'] = (df['cumulative_volume'] // bucket_size).astype(int)
    
    # Calculate order imbalance per bucket
    bucket_stats = df.groupby('bucket_id').agg({
        'buy_vol': 'sum',
        'sell_vol': 'sum',
        'quantity': 'sum',
        'timestamp': ['first', 'last']
    }).reset_index()
    
    bucket_stats.columns = ['bucket_id', 'buy_vol', 'sell_vol', 'total_vol', 'start_time', 'end_time']
    
    # Order imbalance = |buy_vol - sell_vol|
    bucket_stats['volume_imbalance'] = (bucket_stats['buy_vol'] - bucket_stats['sell_vol']).abs()
    
    # VPIN = rolling average of (order imbalance / total volume)
    window = 50  # Number of buckets to look back
    bucket_stats['imbalance_ratio'] = bucket_stats['volume_imbalance'] / (bucket_stats['total_vol'] + 1e-9)
    bucket_stats['vpin'] = bucket_stats['imbalance_ratio'].rolling(window, min_periods=1).mean()
    
    # VPIN volatility (standard deviation of imbalance)
    bucket_stats['vpin_volatility'] = bucket_stats['imbalance_ratio'].rolling(window, min_periods=1).std().fillna(0.0)
    
    # Toxicity score (high VPIN = toxic flow)
    bucket_stats['toxicity_score'] = bucket_stats['vpin'] * (1 + bucket_stats['vpin_volatility'])
    
    # Clean up
    bucket_stats = bucket_stats.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    return bucket_stats


def calculate_order_toxicity(agg):
    """
    Calculate order toxicity index for aggregated bars.
    Combines VPIN-like metrics with price impact and adverse selection.
    """
    agg = agg.copy()
    
    if 'buy_vol' not in agg.columns or 'sell_vol' not in agg.columns:
        agg['order_toxicity'] = 0.0
        agg['adverse_selection'] = 0.0
        return agg
    
    # Order imbalance ratio
    total_vol = agg['buy_vol'] + agg['sell_vol']
    agg['order_imbalance_abs'] = (agg['buy_vol'] - agg['sell_vol']).abs()
    agg['imbalance_ratio'] = agg['order_imbalance_abs'] / (total_vol + 1e-9)
    
    # VPIN-like metric (rolling average of imbalance)
    agg['vpin_proxy'] = agg['imbalance_ratio'].rolling(W_SHORT, min_periods=1).mean()
    
    # Adverse selection (price moves against majority of volume)
    agg['price_change'] = agg['close'] - agg['open']
    agg['volume_direction'] = np.where(agg['buy_vol'] > agg['sell_vol'], 1, -1)
    agg['price_direction'] = np.where(agg['price_change'] > 0, 1, -1)
    agg['adverse_selection'] = (agg['volume_direction'] != agg['price_direction']).astype(int)
    
    # Order toxicity = VPIN * price volatility * adverse selection frequency
    agg['adverse_selection_rate'] = agg['adverse_selection'].rolling(W_SHORT, min_periods=1).mean()
    agg['order_toxicity'] = agg['vpin_proxy'] * agg.get('volatility_short', 1.0) * (1 + agg['adverse_selection_rate'])
    
    # Clean up
    agg['order_toxicity'] = agg['order_toxicity'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    return agg


def decompose_effective_spread(agg):
    """
    Decompose effective spread into adverse selection and realized spread components.
    Effective Spread = Realized Spread + Adverse Selection Cost
    """
    agg = agg.copy()
    
    if 'close' not in agg.columns or 'open' not in agg.columns:
        agg['effective_spread'] = 0.0
        agg['realized_spread'] = 0.0
        agg['adverse_selection_cost'] = 0.0
        return agg
    
    # Estimate effective spread as high-low range
    agg['effective_spread'] = agg['high'] - agg['low']
    
    # Midpoint
    agg['midpoint'] = (agg['high'] + agg['low']) / 2
    
    # Price change (adverse selection proxy)
    agg['midpoint_change'] = agg['midpoint'].diff().fillna(0.0)
    
    # Adverse selection cost (permanent price impact)
    agg['adverse_selection_cost'] = agg['midpoint_change'].abs()
    
    # Realized spread (temporary price impact, mean-reverts)
    agg['realized_spread'] = agg['effective_spread'] - agg['adverse_selection_cost']
    agg['realized_spread'] = agg['realized_spread'].clip(lower=0)  # Can't be negative
    
    # Spread components as % of effective spread
    agg['adverse_selection_pct'] = 100 * agg['adverse_selection_cost'] / (agg['effective_spread'] + 1e-9)
    agg['realized_spread_pct'] = 100 * agg['realized_spread'] / (agg['effective_spread'] + 1e-9)
    
    # Clean up
    agg = agg.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    return agg


# -----------------------
# TIER 2: Market Regime Detection
# -----------------------

def detect_market_regime(agg):
    """
    Detect market regime: Volatility, Trend, and Volume regimes.
    Uses quantile-based classification for robust detection.
    """
    agg = agg.copy()
    
    # Volatility regime
    if 'volatility_short' in agg.columns:
        vol = agg['volatility_short']
    elif 'close' in agg.columns:
        vol = agg['close'].pct_change().rolling(W_SHORT, min_periods=1).std()
    else:
        vol = pd.Series(0, index=agg.index)
    
    vol_q33 = vol.quantile(0.33)
    vol_q67 = vol.quantile(0.67)
    
    agg['volatility_regime'] = 'Normal'
    agg.loc[vol <= vol_q33, 'volatility_regime'] = 'Low'
    agg.loc[vol >= vol_q67, 'volatility_regime'] = 'High'
    
    # Trend regime (ADX proxy using directional movement)
    if 'close' in agg.columns:
        # Calculate directional movement
        agg['price_change'] = agg['close'].diff()
        agg['abs_price_change'] = agg['price_change'].abs()
        
        # Directional indicators
        agg['dm_plus'] = np.where(agg['price_change'] > 0, agg['abs_price_change'], 0)
        agg['dm_minus'] = np.where(agg['price_change'] < 0, agg['abs_price_change'], 0)
        
        # ADX proxy = rolling mean of directional strength
        window = W_MED
        agg['di_plus'] = agg['dm_plus'].rolling(window, min_periods=1).sum()
        agg['di_minus'] = agg['dm_minus'].rolling(window, min_periods=1).sum()
        agg['dx'] = 100 * (agg['di_plus'] - agg['di_minus']).abs() / (agg['di_plus'] + agg['di_minus'] + 1e-9)
        agg['adx_proxy'] = agg['dx'].rolling(window, min_periods=1).mean()
        
        # Trend regime classification
        adx_q33 = agg['adx_proxy'].quantile(0.33)
        adx_q67 = agg['adx_proxy'].quantile(0.67)
        
        agg['trend_regime'] = 'Weak'
        agg.loc[agg['adx_proxy'] >= adx_q33, 'trend_regime'] = 'Moderate'
        agg.loc[agg['adx_proxy'] >= adx_q67, 'trend_regime'] = 'Strong'
        
        # Trend direction
        agg['trend_direction'] = 'Neutral'
        agg.loc[agg['di_plus'] > agg['di_minus'], 'trend_direction'] = 'Up'
        agg.loc[agg['di_minus'] > agg['di_plus'], 'trend_direction'] = 'Down'
    else:
        agg['trend_regime'] = 'Unknown'
        agg['trend_direction'] = 'Unknown'
        agg['adx_proxy'] = 0.0
    
    # Volume regime
    if 'volume' in agg.columns:
        vol_mean = agg['volume'].rolling(W_LONG, min_periods=1).mean()
        vol_ratio = agg['volume'] / (vol_mean + 1e-9)
        
        vol_q33 = vol_ratio.quantile(0.33)
        vol_q67 = vol_ratio.quantile(0.67)
        
        agg['volume_regime'] = 'Normal'
        agg.loc[vol_ratio <= vol_q33, 'volume_regime'] = 'Low'
        agg.loc[vol_ratio >= vol_q67, 'volume_regime'] = 'High'
    else:
        agg['volume_regime'] = 'Unknown'
    
    # Combined regime classification
    agg['market_regime'] = agg['volatility_regime'] + '_' + agg['trend_regime'] + '_' + agg['volume_regime']
    
    return agg


def detect_regime_transitions(agg):
    """
    Detect regime transitions and calculate transition probabilities.
    Returns augmented dataframe and transition matrix.
    """
    agg = agg.copy()
    
    if 'market_regime' not in agg.columns:
        agg['regime_transition'] = 0
        agg['regime_stability'] = 1.0
        return agg, pd.DataFrame()
    
    # Detect transitions
    agg['prev_regime'] = agg['market_regime'].shift(1)
    agg['regime_transition'] = (agg['market_regime'] != agg['prev_regime']).astype(int)
    
    # Regime stability (how long in current regime)
    regime_counts = []
    count = 0
    prev = None
    
    for regime in agg['market_regime']:
        if regime == prev:
            count += 1
        else:
            count = 1
            prev = regime
        regime_counts.append(count)
    
    agg['regime_duration'] = regime_counts
    
    # Stability score (inverse of transition frequency)
    window = W_MED
    agg['regime_stability'] = 1.0 - agg['regime_transition'].rolling(window, min_periods=1).mean()
    
    # Build transition matrix
    valid_data = agg[agg['prev_regime'].notna()][['prev_regime', 'market_regime']]
    if len(valid_data) > 0:
        transition_counts = pd.crosstab(valid_data['prev_regime'], valid_data['market_regime'])
        transition_matrix = transition_counts.div(transition_counts.sum(axis=1), axis=0).fillna(0.0)
    else:
        transition_matrix = pd.DataFrame()
    
    return agg, transition_matrix


def encode_cyclic_time(agg):
    """
    Add cyclic time encoding to aggregated data.
    Encodes hour, day, week patterns using sin/cos.
    """
    agg = agg.copy()
    
    if agg.index.name != 'timestamp' and 'timestamp' not in agg.columns:
        # Try to use index as timestamp
        if isinstance(agg.index, pd.DatetimeIndex):
            timestamps = agg.index
        else:
            return agg
    else:
        timestamps = agg.index if isinstance(agg.index, pd.DatetimeIndex) else agg['timestamp']
    
    # Hour encoding (24-hour cycle)
    hour = timestamps.hour
    agg['hour_sin'] = np.sin(2 * np.pi * hour / 24)
    agg['hour_cos'] = np.cos(2 * np.pi * hour / 24)
    
    # Day of week encoding (7-day cycle)
    day_of_week = timestamps.dayofweek
    agg['dow_sin'] = np.sin(2 * np.pi * day_of_week / 7)
    agg['dow_cos'] = np.cos(2 * np.pi * day_of_week / 7)
    
    # Day of month encoding (30-day cycle approximation)
    day_of_month = timestamps.day
    agg['dom_sin'] = np.sin(2 * np.pi * day_of_month / 30)
    agg['dom_cos'] = np.cos(2 * np.pi * day_of_month / 30)
    
    return agg


def analyze_session_transitions(agg):
    """
    Analyze intraday session patterns and transitions.
    Returns augmented dataframe and session statistics.
    """
    agg = agg.copy()
    
    if not isinstance(agg.index, pd.DatetimeIndex):
        return agg, pd.DataFrame()
    
    # Define sessions
    hour = agg.index.hour
    agg['session'] = 'Unknown'
    agg.loc[(hour >= 0) & (hour < 8), 'session'] = 'Asian'
    agg.loc[(hour >= 8) & (hour < 16), 'session'] = 'European'
    agg.loc[(hour >= 16) & (hour < 20), 'session'] = 'US'
    agg.loc[(hour >= 20) & (hour < 24), 'session'] = 'Late_US'
    
    # Session transitions
    agg['prev_session'] = agg['session'].shift(1)
    agg['session_transition'] = (agg['session'] != agg['prev_session']).astype(int)
    
    # Session statistics
    if 'buy_vol' in agg.columns and 'sell_vol' in agg.columns:
        session_stats = agg.groupby('session').agg({
            'buy_vol': 'sum',
            'sell_vol': 'sum',
            'volume': 'sum',
            'close': ['mean', 'std'],
            'volatility_short': 'mean' if 'volatility_short' in agg.columns else 'count'
        }).reset_index()
        
        session_stats.columns = ['session', 'buy_vol', 'sell_vol', 'total_vol', 'avg_price', 'price_volatility', 'avg_vol_volatility']
        session_stats['buy_ratio'] = session_stats['buy_vol'] / (session_stats['buy_vol'] + session_stats['sell_vol'])
    else:
        session_stats = pd.DataFrame()
    
    return agg, session_stats


# -----------------------
# TIER 2: Smart Money Detection
# -----------------------

def calculate_smart_money_index(agg):
    """
    Calculate Smart Money Index (SMI).
    Compares early session vs late session activity.
    Smart money tends to trade early, retail tends to trade late.
    """
    agg = agg.copy()
    
    if not isinstance(agg.index, pd.DatetimeIndex):
        agg['smart_money_index'] = 0.0
        return agg
    
    hour = agg.index.hour
    
    # Early session (first 2 hours of major sessions)
    early_session = ((hour >= 8) & (hour < 10)) | ((hour >= 16) & (hour < 18))
    
    # Late session (last 2 hours of major sessions)
    late_session = ((hour >= 14) & (hour < 16)) | ((hour >= 22) & (hour < 24))
    
    if 'buy_vol' in agg.columns and 'sell_vol' in agg.columns:
        # Early session net volume
        early_net = np.where(early_session, agg['buy_vol'] - agg['sell_vol'], 0)
        
        # Late session net volume
        late_net = np.where(late_session, agg['buy_vol'] - agg['sell_vol'], 0)
        
        # SMI = cumulative (early - late) net volume
        agg['early_net_volume'] = early_net
        agg['late_net_volume'] = late_net
        agg['smart_money_index'] = (agg['early_net_volume'] - agg['late_net_volume']).cumsum()
        
        # Normalized SMI
        agg['smi_normalized'] = agg['smart_money_index'] / (agg['volume'].rolling(W_LONG, min_periods=1).sum() + 1e-9)
    else:
        agg['smart_money_index'] = 0.0
        agg['smi_normalized'] = 0.0
    
    return agg


# -----------------------
# TIER 2: Exhaustion & Reversal Detection
# -----------------------

def calculate_exhaustion_score(agg):
    """
    Calculate buyer and seller exhaustion scores.
    Exhaustion = high volume + slowing momentum + divergences
    """
    agg = agg.copy()
    
    # Volume exhaustion (high volume but price not moving)
    if 'volume' in agg.columns and 'close' in agg.columns:
        vol_ma = agg['volume'].rolling(W_LONG, min_periods=1).mean()
        vol_spike = agg['volume'] / (vol_ma + 1e-9)
        
        price_change = agg['close'].diff().abs()
        price_momentum = price_change.rolling(W_SHORT, min_periods=1).mean()
        
        # Exhaustion = high volume but low price momentum
        agg['volume_exhaustion'] = vol_spike / (price_momentum + 1e-9)
        agg['volume_exhaustion'] = agg['volume_exhaustion'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    else:
        agg['volume_exhaustion'] = 0.0
    
    # Buyer exhaustion (high buy volume but price not rising)
    if 'buy_vol' in agg.columns and 'close' in agg.columns:
        buy_vol_ma = agg['buy_vol'].rolling(W_LONG, min_periods=1).mean()
        buy_spike = agg['buy_vol'] / (buy_vol_ma + 1e-9)
        
        price_change = agg['close'].diff()
        upward_momentum = price_change.rolling(W_SHORT, min_periods=1).mean()
        
        # High buy volume but price not going up = buyer exhaustion
        agg['buyer_exhaustion'] = np.where(
            upward_momentum > 0,
            0,  # Price is rising, no exhaustion
            buy_spike  # Price not rising despite high buy volume
        )
    else:
        agg['buyer_exhaustion'] = 0.0
    
    # Seller exhaustion (high sell volume but price not falling)
    if 'sell_vol' in agg.columns and 'close' in agg.columns:
        sell_vol_ma = agg['sell_vol'].rolling(W_LONG, min_periods=1).mean()
        sell_spike = agg['sell_vol'] / (sell_vol_ma + 1e-9)
        
        price_change = agg['close'].diff()
        downward_momentum = price_change.rolling(W_SHORT, min_periods=1).mean()
        
        # High sell volume but price not going down = seller exhaustion
        agg['seller_exhaustion'] = np.where(
            downward_momentum < 0,
            0,  # Price is falling, no exhaustion
            sell_spike  # Price not falling despite high sell volume
        )
    else:
        agg['seller_exhaustion'] = 0.0
    
    # Combined exhaustion score
    agg['exhaustion_score'] = (agg['buyer_exhaustion'] + agg['seller_exhaustion']) / 2
    
    return agg


def detect_capitulation_events(agg, threshold=2.0):
    """
    Detect capitulation events (panic selling or buying).
    Capitulation = extreme volume + extreme price move + exhaustion
    """
    agg = agg.copy()
    
    if 'volume' not in agg.columns or 'close' not in agg.columns:
        agg['capitulation_event'] = 0
        agg['capitulation_type'] = 'None'
        return agg
    
    # Volume spike
    vol_ma = agg['volume'].rolling(W_LONG, min_periods=1).mean()
    vol_std = agg['volume'].rolling(W_LONG, min_periods=1).std()
    vol_zscore = (agg['volume'] - vol_ma) / (vol_std + 1e-9)
    
    # Price move
    price_change_pct = agg['close'].pct_change() * 100
    price_ma = price_change_pct.rolling(W_LONG, min_periods=1).mean()
    price_std = price_change_pct.rolling(W_LONG, min_periods=1).std()
    price_zscore = (price_change_pct - price_ma) / (price_std + 1e-9)
    
    # Capitulation = extreme volume + extreme price move
    buy_capitulation = (vol_zscore > threshold) & (price_zscore > threshold)
    sell_capitulation = (vol_zscore > threshold) & (price_zscore < -threshold)
    
    agg['capitulation_event'] = 0
    agg.loc[buy_capitulation, 'capitulation_event'] = 1
    agg.loc[sell_capitulation, 'capitulation_event'] = -1
    
    agg['capitulation_type'] = 'None'
    agg.loc[buy_capitulation, 'capitulation_type'] = 'Buy_Capitulation'
    agg.loc[sell_capitulation, 'capitulation_type'] = 'Sell_Capitulation'
    
    return agg


def detect_divergences(agg):
    """
    Detect bullish and bearish divergences between price and volume/momentum.
    Divergence = price makes new high/low but indicator doesn't confirm.
    """
    agg = agg.copy()
    
    if 'close' not in agg.columns:
        agg['bullish_divergence'] = 0
        agg['bearish_divergence'] = 0
        return agg
    
    window = W_MED
    
    # Price highs and lows
    price_high = agg['close'].rolling(window, min_periods=1).max()
    price_low = agg['close'].rolling(window, min_periods=1).min()
    
    is_price_high = agg['close'] >= price_high
    is_price_low = agg['close'] <= price_low
    
    # Volume/momentum indicator (use CVD if available, else volume)
    if 'CVD' in agg.columns:
        indicator = agg['CVD']
    elif 'volume' in agg.columns:
        indicator = agg['volume']
    else:
        indicator = pd.Series(0, index=agg.index)
    
    indicator_high = indicator.rolling(window, min_periods=1).max()
    indicator_low = indicator.rolling(window, min_periods=1).min()
    
    # Bearish divergence: price makes new high but indicator doesn't
    bearish_div = is_price_high & (indicator < indicator_high)
    
    # Bullish divergence: price makes new low but indicator doesn't
    bullish_div = is_price_low & (indicator > indicator_low)
    
    agg['bullish_divergence'] = bullish_div.astype(int)
    agg['bearish_divergence'] = bearish_div.astype(int)
    
    # Divergence score (how strong is the divergence)
    agg['divergence_score'] = agg['bearish_divergence'] - agg['bullish_divergence']
    
    return agg


# -----------------------
# TIER 2: Absorption & Iceberg Detection
# -----------------------

def detect_absorption_zones(agg):
    """
    Detect absorption zones where large volume doesn't move price.
    Absorption = high volume + low price movement = hidden liquidity
    """
    agg = agg.copy()
    
    if 'volume' not in agg.columns or 'close' not in agg.columns:
        agg['absorption_score'] = 0.0
        agg['is_absorption_zone'] = 0
        return agg
    
    # Price efficiency = price change / volume
    price_change = (agg['close'] - agg['open']).abs()
    price_efficiency = price_change / (agg['volume'] + 1e-9)
    
    # Absorption = low price efficiency (volume absorbs price moves)
    # Normalize by rolling stats
    eff_ma = price_efficiency.rolling(W_LONG, min_periods=1).mean()
    eff_std = price_efficiency.rolling(W_LONG, min_periods=1).std()
    eff_zscore = (price_efficiency - eff_ma) / (eff_std + 1e-9)
    
    # Absorption score (negative z-score = low efficiency = absorption)
    agg['absorption_score'] = -eff_zscore
    agg['absorption_score'] = agg['absorption_score'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    # Mark absorption zones (threshold = 1 std below mean)
    agg['is_absorption_zone'] = (agg['absorption_score'] > 1.0).astype(int)
    
    return agg


def detect_iceberg_orders(df, volume_threshold_percentile=95, size_std_threshold=2.0):
    """
    Detect potential iceberg orders in raw trade data.
    Iceberg = multiple trades of similar size at similar price over short time.
    Returns DataFrame with iceberg order clusters.
    """
    df = df.copy()
    
    if 'quantity' not in df.columns or 'price' not in df.columns or 'timestamp' not in df.columns:
        return pd.DataFrame({'iceberg_detected': [0], 'cluster_id': [0], 'total_volume': [0.0]})
    
    # Filter for large trades only
    volume_threshold = df['quantity'].quantile(volume_threshold_percentile / 100.0)
    large_trades = df[df['quantity'] >= volume_threshold].copy()
    
    if len(large_trades) < 3:
        return pd.DataFrame({'iceberg_detected': [0], 'cluster_id': [0], 'total_volume': [0.0]})
    
    # Group trades by time windows (1-minute windows)
    large_trades['time_bucket'] = large_trades['timestamp'].dt.floor('1min')
    
    # Analyze each time bucket
    iceberg_clusters = []
    
    for bucket, group in large_trades.groupby('time_bucket'):
        if len(group) < 3:
            continue
        
        # Check if sizes are similar (low standard deviation)
        size_mean = group['quantity'].mean()
        size_std = group['quantity'].std()
        size_cv = size_std / (size_mean + 1e-9)  # Coefficient of variation
        
        # Check if prices are similar
        price_range = group['price'].max() - group['price'].min()
        price_mean = group['price'].mean()
        price_range_pct = price_range / (price_mean + 1e-9) * 100
        
        # Iceberg signature: many similar-sized trades at similar price
        if size_cv < 0.2 and price_range_pct < 0.5:  # Low variation in size and price
            iceberg_clusters.append({
                'timestamp': bucket,
                'trade_count': len(group),
                'total_volume': group['quantity'].sum(),
                'avg_size': size_mean,
                'size_std': size_std,
                'price_range_pct': price_range_pct,
                'buy_volume': group['buy_vol'].sum(),
                'sell_volume': group['sell_vol'].sum(),
                'iceberg_score': len(group) * (1 - size_cv) * (1 - price_range_pct / 100)
            })
    
    if len(iceberg_clusters) == 0:
        return pd.DataFrame({'iceberg_detected': [0], 'cluster_id': [0], 'total_volume': [0.0]})
    
    iceberg_df = pd.DataFrame(iceberg_clusters)
    iceberg_df['cluster_id'] = range(len(iceberg_df))
    iceberg_df['iceberg_detected'] = 1
    
    return iceberg_df


# -----------------------
# Rolling percentile-based detector (buyers) with microstructure enhancement
# -----------------------
def detect_buyer_sessions_sensitive(agg15):
    a = agg15.copy()
    # ensure base columns
    for c in ['buy_vol','buy_value','OFI','CVD','PI','delta','mean_dt','volatility_trade','trade_count']:
        if c not in a.columns:
            a.loc[:, c] = 0.0

    # Add microstructure features
    a = add_micro_features(a)

    # core rolling features (existing)
    a.loc[:, 'buy_speed_ma'] = a['buy_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'sell_speed_ma'] = a['sell_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'VDM_roll'] = a['buy_speed_ma'] / (a['sell_speed_ma'] + 1e-9)
    a.loc[:, 'CVD_roll_slope_med'] = a['CVD'].rolling(W_MED, min_periods=1).apply(lambda s: s.iloc[-1] - s.iloc[0])

    # z-normalize core features on long baseline
    core_cols = ['buy_vol','buy_value','OFI','CVD_roll_slope_med','VDM_roll']
    for col in core_cols:
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    # core composite (original)
    a.loc[:, 'buyer_score_roll_core'] = (
        0.4 * a['buy_value_zn_roll'] +
        0.25 * a['buy_vol_zn_roll'] +
        0.2 * a['OFI_zn_roll'] +
        0.1 * a['CVD_roll_slope_med_zn_roll'] +
        0.05 * a['VDM_roll_zn_roll']
    )

    # microstructure enhancements for BUYERS
    micro_cols_buy = [
        'ATD_norm', 'ATD_vol_adj', 'ATVD_norm', 'ATVD_vol_adj',
        'VASP_buy', 'VSB_buy',
        'buy_burst', 'SIR_buy', 'TCP_buy', 'MLS_buy'
    ]
    for col in micro_cols_buy:
        if col not in a.columns:
            a.loc[:, col] = 0.0
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    enh_cols = [c + '_zn_roll' for c in micro_cols_buy]
    if len(enh_cols) > 0:
        a.loc[:, 'buyer_micro_enhancement'] = a[enh_cols].mean(axis=1).fillna(0.0)
    else:
        a.loc[:, 'buyer_micro_enhancement'] = 0.0

    # final roll: blend core and enhancement
    a.loc[:, 'buyer_score_roll'] = 0.8 * a['buyer_score_roll_core'] + 0.2 * a['buyer_micro_enhancement']

    # EWM smoothing and thresholding
    a.loc[:, 'buyer_score_ewm'] = a['buyer_score_roll'].ewm(span=EWM_SPAN, adjust=False).mean()
    a.loc[:, 'threshold_strong'] = a['buyer_score_ewm'].rolling(W_LONG, min_periods=1).quantile(STRONG_Q)
    a.loc[:, 'threshold_soft'] = a['buyer_score_ewm'].rolling(W_LONG, min_periods=1).quantile(SOFT_Q)
    a.loc[:, 'is_buyer_strong'] = a['buyer_score_ewm'] > a['threshold_strong']
    a.loc[:, 'is_buyer_soft'] = a['buyer_score_ewm'] > a['threshold_soft']
    a.loc[:, 'is_buyer_window_final'] = a['is_buyer_strong'] | a['is_buyer_soft']

    # sessions
    a.loc[:, 'session_id_final'] = (a['is_buyer_window_final'] != a['is_buyer_window_final'].shift(1)).cumsum()
    sessions = []
    for sid, g in a.groupby('session_id_final'):
        if not g['is_buyer_window_final'].iloc[0]:
            continue
        start_ts, end_ts = g.index.min(), g.index.max()
        duration_min = (end_ts - start_ts) / pd.Timedelta(minutes=1)
        sessions.append({
            'start': start_ts,
            'end': end_ts,
            'duration_min': float(duration_min),
            'max_buyer_score_ewm': float(g['buyer_score_ewm'].max()),
            'mean_OFI': float(g['OFI'].mean()),
            'total_buy_value': float(g['buy_value'].sum()),
            'total_buy_vol': float(g['buy_vol'].sum()),
            'avg_PI': float(g['PI'].mean()),
            'is_strong_session': bool(g['is_buyer_strong'].any()),
            'is_soft_session': bool(g['is_buyer_soft'].any())
        })

    return a, pd.DataFrame(sessions)

