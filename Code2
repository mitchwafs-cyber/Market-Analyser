# ML Anomaly Detection (updated features)
# -----------------------
def ml_anomaly_detection(agg_data):
    a = agg_data.copy()
    feats = [
        'buy_value','buy_vol','sell_value','sell_vol','OFI','CVD','PI','Absorption',
        'trade_count','ATD_norm','ATD_vol_adj','ATVD_norm','ATVD_vol_adj',
        'VASP_buy','VASP_sell','buy_burst','sell_burst',
        'VSB','VSB_buy','SIR_buy','SIR_sell','TCP_buy','TCP_sell','MLS_buy','MLS_sell'
    ]
    for f in feats:
        if f not in a.columns:
            a.loc[:, f] = 0.0
    X = a[feats].fillna(0.0).values
    if SKLEARN and len(a) > 0:
        scaler = StandardScaler()
        Xs = scaler.fit_transform(X)
        iso = IsolationForest(contamination=ISO_CONTAMINATION, random_state=42)
        iso.fit(Xs)
        a.loc[:, 'ml_anomaly_score'] = iso.decision_function(Xs)
        a.loc[:, 'is_ml_anomaly'] = iso.predict(Xs) == -1
    else:
        a.loc[:, 'ml_anomaly_score'] = 0.0
        a.loc[:, 'is_ml_anomaly'] = False
    return a

