def add_market_context(df):
    df = df.copy()
    if 'transact_time' in df.columns:
        df.loc[:, 'timestamp'] = pd.to_datetime(df['transact_time'], unit='ms')
    elif 'timestamp' in df.columns:
        df.loc[:, 'timestamp'] = pd.to_datetime(df['timestamp'])
    else:
        raise KeyError("No timestamp/transact_time column found")

    df = df.sort_values('timestamp').reset_index(drop=True)

    if 'price' in df.columns:
        df.loc[:, 'price_change'] = df['price'].pct_change().fillna(0.0)
        df.loc[:, 'volatility_trade'] = df['price_change'].rolling(100, min_periods=1).std().fillna(0.0)
    else:
        df.loc[:, 'price_change'] = 0.0
        df.loc[:, 'volatility_trade'] = 0.0

    if 'quantity' in df.columns:
        trade_size_q75 = df['quantity'].quantile(0.75)
        df.loc[:, 'is_whale_trade'] = df['quantity'] > trade_size_q75
    else:
        df.loc[:, 'is_whale_trade'] = False

    return df

