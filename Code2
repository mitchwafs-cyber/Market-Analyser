def load_csv_from_zip(zip_path):
    with zipfile.ZipFile(zip_path, 'r') as z:
        csvs = [n for n in z.namelist() if n.endswith('.csv')]
        if not csvs:
            raise FileNotFoundError("No CSV found in zip")
        with z.open(csvs[0]) as f:
            df = pd.read_csv(f)
    return df

