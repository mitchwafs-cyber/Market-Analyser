def calculate_daily_dominance(buyer_sessions, seller_sessions, agg_data=None):
    bs = buyer_sessions if (buyer_sessions is not None and not buyer_sessions.empty) else pd.DataFrame(columns=['total_buy_vol','total_buy_value','duration_min','is_strong_session'])
    ss = seller_sessions if (seller_sessions is not None and not seller_sessions.empty) else pd.DataFrame(columns=['total_sell_vol','total_sell_value','duration_min','is_strong_session'])

    total_buy_vol = bs['total_buy_vol'].sum() if 'total_buy_vol' in bs.columns else 0.0
    total_sell_vol = ss['total_sell_vol'].sum() if 'total_sell_vol' in ss.columns else 0.0
    volume_dominance = 0.0
    if (total_buy_vol + total_sell_vol) > 0:
        volume_dominance = (total_buy_vol - total_sell_vol) / (total_buy_vol + total_sell_vol)

    total_buy_value = bs['total_buy_value'].sum() if 'total_buy_value' in bs.columns else 0.0
    total_sell_value = ss['total_sell_value'].sum() if 'total_sell_value' in ss.columns else 0.0
    value_dominance = 0.0
    if (total_buy_value + total_sell_value) > 0:
        value_dominance = (total_buy_value - total_sell_value) / (total_buy_value + total_sell_value)

    total_buy_time = bs['duration_min'].sum() if 'duration_min' in bs.columns else 0.0
    total_sell_time = ss['duration_min'].sum() if 'duration_min' in ss.columns else 0.0
    time_dominance = 0.0
    if (total_buy_time + total_sell_time) > 0:
        time_dominance = (total_buy_time - total_sell_time) / (total_buy_time + total_sell_time)

    strong_buy_sessions = bs[bs['is_strong_session']].shape[0] if 'is_strong_session' in bs.columns else 0
    strong_sell_sessions = ss[ss['is_strong_session']].shape[0] if 'is_strong_session' in ss.columns else 0
    strength_dominance = 0.0
    denom = max(strong_buy_sessions + strong_sell_sessions, 1)
    strength_dominance = (strong_buy_sessions - strong_sell_sessions) / denom

    composite_dominance = (
        0.35 * volume_dominance +
        0.35 * value_dominance +
        0.15 * time_dominance +
        0.15 * strength_dominance
    )

    dominance_type = 'BALANCED'
    if composite_dominance > 0.1:
        dominance_type = 'BUYERS'
    elif composite_dominance < -0.1:
        dominance_type = 'SELLERS'

    return {
        'composite_dominance_score': composite_dominance,
        'dominance_type': dominance_type,
        'volume_dominance': volume_dominance,
        'value_dominance': value_dominance,
        'time_dominance': time_dominance,
        'strength_dominance': strength_dominance,
        'total_buy_volume': total_buy_vol,
        'total_sell_volume': total_sell_vol,
        'total_buy_value': total_buy_value,
        'total_sell_value': total_sell_value
    }

def categorize_sessions(sessions_df, session_type='buyer'):
    if sessions_df is None or sessions_df.empty:
        return sessions_df if isinstance(sessions_df, pd.DataFrame) else pd.DataFrame()

    df = sessions_df.copy()

    volume_col = f'total_{session_type}_vol'
    value_col = f'total_{session_type}_value'
    score_col = f'max_{session_type}_score_ewm' if f'max_{session_type}_score_ewm' in df.columns else (f'max_{session_type}_score_ewm' if 'max_buyer_score_ewm' in df.columns else None)

    if volume_col not in df.columns:
        df[volume_col] = 0.0
    if value_col not in df.columns:
        df[value_col] = 0.0
    if score_col not in df.columns:
        if f'max_buyer_score_ewm' in df.columns:
            score_col = 'max_buyer_score_ewm'
        elif f'max_seller_score_ewm' in df.columns:
            score_col = 'max_seller_score_ewm'
        else:
            df['score_col_tmp'] = 0.0
            score_col = 'score_col_tmp'

    try:
        volume_q33 = df[volume_col].quantile(0.33)
        volume_q66 = df[volume_col].quantile(0.66)
    except Exception:
        volume_q33, volume_q66 = 0.0, 0.0

    try:
        value_q33 = df[value_col].quantile(0.33)
        value_q66 = df[value_col].quantile(0.66)
    except Exception:
        value_q33, value_q66 = 0.0, 0.0

    try:
        score_q33 = df[score_col].quantile(0.33)
        score_q66 = df[score_col].quantile(0.66)
    except Exception:
        score_q33, score_q66 = 0.0, 0.0

    duration_q33 = df['duration_min'].quantile(0.33) if 'duration_min' in df.columns else 0.0
    duration_q66 = df['duration_min'].quantile(0.66) if 'duration_min' in df.columns else 0.0

    def get_category(row):
        score = 0.0
        if row.get(volume_col, 0.0) >= volume_q66:
            score += 2
        elif row.get(volume_col, 0.0) >= volume_q33:
            score += 1
        if row.get(value_col, 0.0) >= value_q66:
            score += 2
        elif row.get(value_col, 0.0) >= value_q33:
            score += 1
        if row.get(score_col, 0.0) >= score_q66:
            score += 2
        elif row.get(score_col, 0.0) >= score_q33:
            score += 1
        if row.get('duration_min', 0.0) >= duration_q66:
            score += 1
        elif row.get('duration_min', 0.0) >= duration_q33:
            score += 0.5

        if score >= 6:
            return 'AGGRESSIVE'
        elif score >= 3:
            return 'MODERATE'
        else:
            return 'PASSIVE'

    df[f'{session_type}_category'] = df.apply(get_category, axis=1)
    return df

def identify_price_zones_of_interest(agg_data, price_bin_size=10.0):
    if agg_data is None or agg_data.empty:
        return {
            'all_zones': pd.DataFrame(),
            'significant_zones': pd.DataFrame(),
            'key_support_levels': pd.DataFrame(),
            'key_resistance_levels': pd.DataFrame()
        }

    a = agg_data.copy()
    if 'close' not in a.columns:
        a['close'] = a['open']

    a.loc[:, 'price_zone'] = (a['close'] // price_bin_size) * price_bin_size

    zone_analysis = a.groupby('price_zone').agg({
        'buy_value': 'sum',
        'sell_value': 'sum',
        'buy_vol': 'sum',
        'sell_vol': 'sum',
        'volume': 'sum',
        'OFI': 'mean',
        'CVD': 'last',
        'trade_count': 'sum'
    }).reset_index()

    zone_analysis['total_value'] = zone_analysis['buy_value'] + zone_analysis['sell_value']
    zone_analysis['net_value_flow'] = zone_analysis['buy_value'] - zone_analysis['sell_value']
    zone_analysis['buy_pressure_ratio'] = zone_analysis['buy_value'] / (zone_analysis['total_value'] + 1e-9)
    total_vol_sum = zone_analysis['volume'].sum() if 'volume' in zone_analysis.columns else 1.0
    zone_analysis['volume_concentration'] = zone_analysis['volume'] / (total_vol_sum + 1e-9)

    volume_threshold = zone_analysis['volume'].quantile(0.80) if not zone_analysis['volume'].empty else 0.0
    significant_zones = zone_analysis[zone_analysis['volume'] >= volume_threshold].copy()

    def categorize_zone(row):
        if row['buy_pressure_ratio'] >= 0.6:
            return 'STRONG_BUY_ZONE'
        elif row['buy_pressure_ratio'] >= 0.55:
            return 'MODERATE_BUY_ZONE'
        elif row['buy_pressure_ratio'] <= 0.4:
            return 'STRONG_SELL_ZONE'
        elif row['buy_pressure_ratio'] <= 0.45:
            return 'MODERATE_SELL_ZONE'
        else:
            return 'BALANCED_ZONE'

    significant_zones['zone_type'] = significant_zones.apply(categorize_zone, axis=1)

    key_support_levels = significant_zones[significant_zones['zone_type'].str.contains('BUY', na=False)].nlargest(3, 'volume')[['price_zone','zone_type','volume']] if not significant_zones.empty else pd.DataFrame()
    key_resistance_levels = significant_zones[significant_zones['zone_type'].str.contains('SELL', na=False)].nlargest(3, 'volume')[['price_zone','zone_type','volume']] if not significant_zones.empty else pd.DataFrame()

    return {
        'all_zones': zone_analysis.sort_values('volume', ascending=False),
        'significant_zones': significant_zones.sort_values('volume', ascending=False),
        'key_support_levels': key_support_levels,
        'key_resistance_levels': key_resistance_levels
    }

def analyze_sessions_with_price_context(sessions_df, agg_data, session_type='buyer'):
    if sessions_df is None or sessions_df.empty:
        return sessions_df if isinstance(sessions_df, pd.DataFrame) else pd.DataFrame()

    sessions_with_price = sessions_df.copy()
    price_levels = []
    for _, session in sessions_df.iterrows():
        start = session['start']
        end = session['end']
        session_data = agg_data[(agg_data.index >= start) & (agg_data.index <= end)]
        if session_data is None or session_data.empty:
            price_levels.append({
                'session_start': session['start'],
                'session_high': np.nan,
                'session_low': np.nan,
                'session_vwap': np.nan,
                'price_range': np.nan,
                'predominant_zone': np.nan
            })
            continue

        session_high = session_data['high'].max() if 'high' in session_data.columns else session_data['close'].max()
        session_low = session_data['low'].min() if 'low' in session_data.columns else session_data['close'].min()
        total_buy_value = session_data.get('buy_value', pd.Series(0.0)).sum()
        total_sell_value = session_data.get('sell_value', pd.Series(0.0)).sum()
        total_buy_vol = session_data.get('buy_vol', pd.Series(0.0)).sum()
        total_sell_vol = session_data.get('sell_vol', pd.Series(0.0)).sum()
        denom = total_buy_vol + total_sell_vol
        if denom == 0:
            session_vwap = np.nan
        else:
            session_vwap = (total_buy_value + total_sell_value) / (denom + 1e-9)

        pred_zone = np.nan
        try:
            pred_zone = (session_vwap // 10) * 10 if not np.isnan(session_vwap) else np.nan
        except Exception:
            pred_zone = np.nan

        price_levels.append({
            'session_start': session['start'],
            'session_high': session_high,
            'session_low': session_low,
            'session_vwap': session_vwap,
            'price_range': session_high - session_low if (not pd.isna(session_high) and not pd.isna(session_low)) else np.nan,
            'predominant_zone': pred_zone
        })

    price_df = pd.DataFrame(price_levels)
    if not price_df.empty:
        sessions_with_price = sessions_with_price.merge(price_df, left_on='start', right_on='session_start', how='left')
    else:
        for col in ['session_high','session_low','session_vwap','price_range','predominant_zone']:
            sessions_with_price[col] = np.nan

    return sessions_with_price

