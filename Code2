            before_clip = len(df)
            df = df[df['price'].between(pm - PRICE_SIGMA_THRESHOLD*ps, pm + PRICE_SIGMA_THRESHOLD*ps)].copy()
            clipped = before_clip - len(df)
            quality_report.metrics['outliers_removed'] = clipped
            if clipped > 0:
                print(f"✓ Removed {clipped} price outliers (>{PRICE_SIGMA_THRESHOLD} sigma)")
    
    df = df.reset_index(drop=True)
    
    final_count = len(df)
    data_retained = (final_count / original_count * 100) if original_count > 0 else 0
    print(f"\n✅ Data cleaning complete:")
    print(f"   • Original: {original_count:,} trades")
    print(f"   • Retained: {final_count:,} trades ({data_retained:.2f}%)")
    print(f"   • Removed: {original_count - final_count:,} trades")
    
