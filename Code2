def calculate_kyles_lambda(agg):
    """
    Calculate Kyle's Lambda (price impact coefficient).
    Lambda = price change / signed volume
    Measures permanent price impact per unit of order flow.
    """
    agg = agg.copy()
    
    if 'close' not in agg.columns or 'open' not in agg.columns or 'delta' not in agg.columns:
        agg['kyles_lambda'] = 0.0
        agg['kyles_lambda_ma'] = 0.0
        return agg
    
    # Price change per bar
    price_change = agg['close'] - agg['open']
    
    # Kyle's Lambda = price change / signed volume (delta)
    agg['kyles_lambda'] = price_change / (agg['delta'].abs() + 1e-9)
    agg['kyles_lambda'] = agg['kyles_lambda'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    # Rolling average for smoothing
    agg['kyles_lambda_ma'] = agg['kyles_lambda'].rolling(W_SHORT, min_periods=1).mean()
    
    return agg


def calculate_amihud_illiquidity(agg):
    """
    Calculate Amihud illiquidity ratio.
    Illiquidity = |price return| / volume
    Higher values indicate lower liquidity (higher price impact per volume).
    """
    agg = agg.copy()
    
    if 'close' not in agg.columns or 'volume' not in agg.columns:
        agg['amihud_illiquidity'] = 0.0
        agg['amihud_illiquidity_ma'] = 0.0
        return agg
    
    # Price return (percentage)
    agg['price_return'] = agg['close'].pct_change().fillna(0.0)
    
    # Amihud ratio = |return| / volume
    agg['amihud_illiquidity'] = agg['price_return'].abs() / (agg['volume'] + 1e-9)
    agg['amihud_illiquidity'] = agg['amihud_illiquidity'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    # Rolling average
    agg['amihud_illiquidity_ma'] = agg['amihud_illiquidity'].rolling(W_SHORT, min_periods=1).mean()
    
    return agg


def calculate_liquidity_depth_score(agg):
    """
    Calculate liquidity depth score based on volume and spread estimates.
    Higher score = better liquidity (high volume, low spread, low price impact).
    """
    agg = agg.copy()
    
    # Normalize components
    volume_score = agg.get('volume', 0.0) / (agg.get('volume', 0.0).rolling(W_LONG, min_periods=1).mean() + 1e-9)
    impact_score = 1.0 / (agg.get('kyles_lambda', 1.0).abs() + 1e-9)  # Inverse of price impact
    illiquidity_score = 1.0 / (agg.get('amihud_illiquidity', 1.0) + 1e-9)  # Inverse of illiquidity
    
    # Combined liquidity score
    agg['liquidity_depth_score'] = (volume_score * 0.4 + impact_score * 0.3 + illiquidity_score * 0.3)
    agg['liquidity_depth_score'] = agg['liquidity_depth_score'].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    return agg


