def calculate_timeframe_alignment(timeframe_dict):
    """
    Calculate alignment scores across multiple timeframes.
    Measures if signals agree across timeframes (coherence).
    
    Args:
        timeframe_dict: Dict with keys like '1min', '5min', etc., values are DataFrames
    
    Returns:
        DataFrame with alignment scores per timestamp
    """
    if not timeframe_dict or len(timeframe_dict) < 2:
        return pd.DataFrame({'alignment_score': [0.0]})
    
    # Use lowest timeframe as base
    base_tf_name = '1min'
    if base_tf_name not in timeframe_dict:
        base_tf_name = list(timeframe_dict.keys())[0]
    
    base_df = timeframe_dict[base_tf_name].copy()
    
    if not isinstance(base_df.index, pd.DatetimeIndex):
        return pd.DataFrame({'alignment_score': [0.0]})
    
    # Initialize alignment tracking
    alignment_data = pd.DataFrame(index=base_df.index)
    alignment_data['timestamp'] = base_df.index
    
    # For each timeframe, resample key signals to base timeframe
    signal_cols = ['buyer_score_roll', 'seller_score_roll', 'OFI', 'CVD']
    
    for tf_name, tf_df in timeframe_dict.items():
        if tf_name == base_tf_name:
            continue
        
        if not isinstance(tf_df.index, pd.DatetimeIndex):
            continue
        
        # Resample to base timeframe (forward fill)
        for col in signal_cols:
            if col in tf_df.columns:
                resampled = tf_df[col].resample(base_df.index.freq or '1min').ffill()
                alignment_data[f'{col}_{tf_name}'] = resampled.reindex(base_df.index, method='ffill')
    
    # Calculate alignment scores
    # Alignment = correlation or directional agreement across timeframes
    
    # Directional alignment (all timeframes agree on direction)
    for col in signal_cols:
        if col not in base_df.columns:
            continue
        
        base_signal = base_df[col]
        base_direction = np.sign(base_signal)
        
        agreement_counts = []
        for tf_name in timeframe_dict.keys():
            if tf_name == base_tf_name:
                continue
            
            col_name = f'{col}_{tf_name}'
            if col_name in alignment_data.columns:
                tf_direction = np.sign(alignment_data[col_name])
                agreement = (base_direction == tf_direction).astype(int)
                agreement_counts.append(agreement)
        
        if len(agreement_counts) > 0:
            # Average agreement across timeframes
            alignment_data[f'{col}_alignment'] = np.mean(agreement_counts, axis=0)
    
    # Overall alignment score (average of all signal alignments)
    alignment_cols = [c for c in alignment_data.columns if c.endswith('_alignment')]
    if len(alignment_cols) > 0:
        alignment_data['alignment_score'] = alignment_data[alignment_cols].mean(axis=1)
    else:
        alignment_data['alignment_score'] = 0.5  # Neutral
    
    # Alignment strength (0 = complete disagreement, 1 = complete agreement)
    alignment_data['alignment_strength'] = alignment_data['alignment_score']
    
    # Signal conflict (low alignment = conflicting signals)
    alignment_data['signal_conflict'] = (alignment_data['alignment_score'] < 0.3).astype(int)
    
    return alignment_data


def calculate_cross_timeframe_correlation(timeframe_dict, window=20):
    """
    Calculate rolling correlation between key metrics across timeframes.
    
    Returns:
        DataFrame with correlation matrix and time-varying correlation stats
    """
    if not timeframe_dict or len(timeframe_dict) < 2:
        return pd.DataFrame({'correlation': [0.0]})
    
    # Extract key metrics from each timeframe
    metrics_to_correlate = ['CVD', 'OFI', 'buyer_score_roll', 'volume']
    
    correlation_results = []
    
    timeframe_names = list(timeframe_dict.keys())
    
    # Calculate pairwise correlations
    for i, tf1_name in enumerate(timeframe_names):
        for j, tf2_name in enumerate(timeframe_names):
            if i >= j:  # Skip diagonal and duplicate pairs
                continue
            
            tf1_df = timeframe_dict[tf1_name]
            tf2_df = timeframe_dict[tf2_name]
            
            if not isinstance(tf1_df.index, pd.DatetimeIndex) or not isinstance(tf2_df.index, pd.DatetimeIndex):
                continue
            
            for metric in metrics_to_correlate:
                if metric not in tf1_df.columns or metric not in tf2_df.columns:
                    continue
                
                # Resample both to common timeframe (use coarser one)
                # Determine which is coarser
                if len(tf1_df) < len(tf2_df):
                    common_freq = tf1_df.index.freq or pd.infer_freq(tf1_df.index) or '5min'
                    s1 = tf1_df[metric]
                    s2 = tf2_df[metric].resample(common_freq).mean()
                else:
                    common_freq = tf2_df.index.freq or pd.infer_freq(tf2_df.index) or '5min'
                    s1 = tf1_df[metric].resample(common_freq).mean()
                    s2 = tf2_df[metric]
                
                # Align series
                aligned = pd.DataFrame({'s1': s1, 's2': s2}).dropna()
                
                if len(aligned) < window:
                    continue
                
                # Rolling correlation
                rolling_corr = aligned['s1'].rolling(window, min_periods=window//2).corr(aligned['s2'])
                
                # Average correlation
                avg_corr = rolling_corr.mean()
                std_corr = rolling_corr.std()
                
                correlation_results.append({
                    'timeframe_1': tf1_name,
                    'timeframe_2': tf2_name,
                    'metric': metric,
                    'avg_correlation': avg_corr,
                    'std_correlation': std_corr,
                    'min_correlation': rolling_corr.min(),
                    'max_correlation': rolling_corr.max()
                })
    
    if len(correlation_results) == 0:
        return pd.DataFrame({'correlation': [0.0]})
    
    correlation_df = pd.DataFrame(correlation_results)
    
    return correlation_df


def calculate_fractal_dimension(series, max_lag=20):
    """
    Calculate fractal dimension of a time series using Higuchi's method.
    Fractal dimension measures complexity/roughness of the series.
    Values between 1-2: closer to 1 = trending, closer to 2 = random.
    """
    if len(series) < max_lag * 2:
        return 1.5  # Neutral value
    
    series = np.array(series)
    N = len(series)
    
    # Remove NaN and inf
    series = series[np.isfinite(series)]
    if len(series) < max_lag * 2:
        return 1.5
    
    N = len(series)
    
    # Higuchi's method
    L = []
    k_values = range(1, max_lag + 1)
    
    for k in k_values:
        Lk = []
        for m in range(k):
            Lmk = 0
            max_idx = int((N - m - 1) / k)
            for i in range(1, max_idx + 1):
                Lmk += abs(series[m + i * k] - series[m + (i - 1) * k])
            
            if max_idx > 0:
                Lmk = Lmk * (N - 1) / (max_idx * k * k)
                Lk.append(Lmk)
        
        if len(Lk) > 0:
            L.append(np.mean(Lk))
    
    if len(L) < 2:
        return 1.5
    
    # Linear regression on log-log plot
    x = np.log(k_values[:len(L)])
    y = np.log(L)
    
    # Remove any inf or nan
    valid = np.isfinite(x) & np.isfinite(y)
    x = x[valid]
    y = y[valid]
    
    if len(x) < 2:
        return 1.5
    
    # Fit line: y = mx + b, fractal dimension = -m
    coeffs = np.polyfit(x, y, 1)
    fractal_dim = -coeffs[0]
    
    # Constrain to valid range [1, 2]
    fractal_dim = np.clip(fractal_dim, 1.0, 2.0)
    
    return fractal_dim


def detect_institutional_footprint(df, timeframe='1min'):
    """
    Detect institutional activity footprint across the dataset.
    Combines whale detection, iceberg orders, and smart money indicators.
    
    Returns:
        DataFrame with institutional activity summary
    """
    df = df.copy()
    
    # Ensure we have necessary columns
    if 'is_institutional' not in df.columns:
        df, _ = analyze_trade_size_distribution(df)
    
    # Aggregate by timeframe
    if 'timestamp' not in df.columns:
        return pd.DataFrame({'institutional_activity': [0.0]})
    
    df_agg = df.set_index('timestamp').resample(timeframe).agg({
        'quantity': 'sum',
        'is_institutional': 'sum',
        'buy_vol': 'sum',
        'sell_vol': 'sum',
        'institutional_score': 'mean',
        'win_rate_5': 'mean' if 'win_rate_5' in df.columns else 'count'
    }).reset_index()
    
    df_agg.columns = ['timestamp', 'total_volume', 'institutional_trades', 'buy_volume', 'sell_volume', 'institutional_score', 'win_rate']
    
    # Institutional dominance
    df_agg['institutional_dominance'] = df_agg['institutional_score']
    
    # Institutional flow direction
    df_agg['institutional_buy_pct'] = 100 * df_agg['buy_volume'] / (df_agg['total_volume'] + 1e-9)
    
    # Mark significant institutional activity (top 10%)
    threshold = df_agg['institutional_score'].quantile(0.90)
    df_agg['is_significant_institutional'] = (df_agg['institutional_score'] > threshold).astype(int)
    
    return df_agg


