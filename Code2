def detect_seller_sessions_sensitive(agg15):
    a = agg15.copy()
    for c in ['sell_vol','sell_value','OFI','CVD','PI','delta','mean_dt','volatility_trade','trade_count']:
        if c not in a.columns:
            a.loc[:, c] = 0.0

    a = add_micro_features(a)

    # core rolling features
    a.loc[:, 'buy_speed_ma'] = a['buy_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'sell_speed_ma'] = a['sell_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'VDM_roll_seller'] = a['sell_speed_ma'] / (a['buy_speed_ma'] + 1e-9)
    a.loc[:, 'CVD_roll_slope_med'] = a['CVD'].rolling(W_MED, min_periods=1).apply(lambda s: s.iloc[-1] - s.iloc[0])

    # z-normalize core
    core_cols = ['sell_vol','sell_value','OFI','CVD_roll_slope_med','VDM_roll_seller']
    for col in core_cols:
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    a.loc[:, 'seller_score_roll_core'] = (
        0.4 * a['sell_value_zn_roll'] +
        0.25 * a['sell_vol_zn_roll'] +
        0.2 * a['OFI_zn_roll'] +
        0.1 * a['CVD_roll_slope_med_zn_roll'] +
        0.05 * a['VDM_roll_seller_zn_roll']
    )

    # micro features for sellers (include new ATVD & VSB)
    micro_cols_sell = [
        'ATD_norm', 'ATD_vol_adj', 'ATVD_norm', 'ATVD_vol_adj',
        'VASP_sell', 'VSB',
        'sell_burst', 'SIR_sell', 'TCP_sell', 'MLS_sell'
    ]
    for col in micro_cols_sell:
        if col not in a.columns:
            a.loc[:, col] = 0.0
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    enh_cols = [c + '_zn_roll' for c in micro_cols_sell]
    if len(enh_cols) > 0:
        a.loc[:, 'seller_micro_enhancement'] = a[enh_cols].mean(axis=1).fillna(0.0)
    else:
        a.loc[:, 'seller_micro_enhancement'] = 0.0

    a.loc[:, 'seller_score_roll'] = 0.8 * a['seller_score_roll_core'] + 0.2 * a['seller_micro_enhancement']

    # smooth + threshold
    a.loc[:, 'seller_score_ewm'] = a['seller_score_roll'].ewm(span=EWM_SPAN, adjust=False).mean()
    a.loc[:, 'threshold_seller_strong'] = a['seller_score_ewm'].rolling(W_LONG, min_periods=1).quantile(STRONG_Q)
    a.loc[:, 'threshold_seller_soft'] = a['seller_score_ewm'].rolling(W_LONG, min_periods=1).quantile(SOFT_Q)
    a.loc[:, 'is_seller_strong'] = a['seller_score_ewm'] > a['threshold_seller_strong']
    a.loc[:, 'is_seller_soft'] = a['seller_score_ewm'] > a['threshold_seller_soft']
    a.loc[:, 'is_seller_window_final'] = a['is_seller_strong'] | a['is_seller_soft']

    a.loc[:, 'seller_session_id'] = (a['is_seller_window_final'] != a['is_seller_window_final'].shift(1)).cumsum()
    sessions = []
    for sid, g in a.groupby('seller_session_id'):
        if not g['is_seller_window_final'].iloc[0]:
            continue
        start_ts, end_ts = g.index.min(), g.index.max()
        duration_min = (end_ts - start_ts) / pd.Timedelta(minutes=1)
        sessions.append({
            'start': start_ts,
            'end': end_ts,
            'duration_min': float(duration_min),
            'max_seller_score_ewm': float(g['seller_score_ewm'].max()),
            'mean_OFI': float(g['OFI'].mean()),
            'total_sell_value': float(g['sell_value'].sum()),
            'total_sell_vol': float(g['sell_vol'].sum()),
            'avg_PI': float(g['PI'].mean()),
            'is_strong_session': bool(g['is_seller_strong'].any()),
            'is_soft_session': bool(g['is_seller_soft'].any())
        })

    return a, pd.DataFrame(sessions)

