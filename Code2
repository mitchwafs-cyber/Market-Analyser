    Identifies the most critical support and resistance levels.
    """
    print("\n" + "="*80)
    print("IDENTIFYING KEY SUPPORT & RESISTANCE LEVELS")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        return {
            'top_support': pd.DataFrame(),
            'top_resistance': pd.DataFrame(),
            'high_volume_zones': pd.DataFrame(),
            'high_value_zones': pd.DataFrame(),
            'reversal_zones': pd.DataFrame()
        }
    
    df = zones_df.copy()
    
    # Warning if very few zones
    if len(df) <= 3:
        print(f"\n⚠️  WARNING: Only {len(df)} zone(s) available for key level identification")
        print(f"   Key level analysis requires diverse zones for meaningful results\n")
    
    # 1. Top Support Levels (Strong Buy Zones)
    support_candidates = df[df['zone_type'].str.contains('BUY', na=False)]
    if len(support_candidates) == 0:
        print(f"\n⚠️  No BUY zones found - cannot identify support levels")
        support = pd.DataFrame()
    else:
        support = support_candidates.nlargest(min(top_n, len(support_candidates)), 'importance_score')
        print(f"\n✓ Top {len(support)} Support Levels (Buy Zones)")
    
    # 2. Top Resistance Levels (Strong Sell Zones)
    resistance_candidates = df[df['zone_type'].str.contains('SELL', na=False)]
    if len(resistance_candidates) == 0:
        print(f"⚠️  No SELL zones found - cannot identify resistance levels")
        resistance = pd.DataFrame()
    else:
        resistance = resistance_candidates.nlargest(min(top_n, len(resistance_candidates)), 'importance_score')
        print(f"✓ Top {len(resistance)} Resistance Levels (Sell Zones)")
    
    # 3. High Volume Zones (most traded)
    high_volume = df.nlargest(min(top_n, len(df)), 'volume')
    print(f"✓ Top {len(high_volume)} High Volume Zones")
    
    # 4. High Value Zones (most dollar flow)
    high_value = df.nlargest(min(top_n, len(df)), 'total_value')
    print(f"✓ Top {len(high_value)} High Value Zones")
    
