def compute_zone_stats(df, bin_size=BIN_SIZE):
    df_zone = df.copy()
    if 'price' not in df_zone.columns:
        return pd.DataFrame()
    df_zone.loc[:, 'price_zone'] = (df_zone['price'] // bin_size) * bin_size
    grouped = df_zone.groupby('price_zone').agg(
        total_buy_vol=('buy_vol','sum'),
        total_sell_vol=('sell_vol','sum'),
        total_buy_value=('buy_value','sum'),
        total_sell_value=('sell_value','sum'),
        trades=('quantity','count'),
        first_time=('timestamp','min'),
        last_time=('timestamp','max')
    )
    grouped['total_vol'] = grouped['total_buy_vol'] + grouped['total_sell_vol']
    grouped['buy_imbalance_pct'] = 100 * grouped['total_buy_vol'] / grouped['total_vol'].replace(0, np.nan)
    return grouped.sort_values('total_buy_value', ascending=False)

# -----------------------
# Helper: add microstructure features to agg frame (shared)
# -----------------------
def add_micro_features(a):
    """
    Add ATD, ATVD, VASP, VSB, burst, SIR, TCP, MLS for both buy and sell sides.
    a: agg (15m) DataFrame indexed by timestamp
    """
    a = a.copy()

    # Basic ATD and normalized version (taker-side delta in volume)
    a.loc[:, 'ATD'] = a['buy_vol'] - a['sell_vol']   # positive => buy-dominant
    a.loc[:, 'ATD_norm'] = a['ATD'] / (a['total_vol'] + 1e-9)

    # Aggressive Taker-Side Value Delta (ATVD) - NEW
    a.loc[:, 'ATVD'] = a['buy_value'] - a['sell_value']
    a.loc[:, 'ATVD_norm'] = a['ATVD'] / (a['buy_value'] + a['sell_value'] + 1e-9)
    a.loc[:, 'ATVD_vol_adj'] = a['ATVD'] / (a['volatility_trade'] + 1e-9)

    # volatility-adjusted ATD (use agg volatility_trade if available)
    a.loc[:, 'ATD_vol_adj'] = a['ATD'] / (a['volatility_trade'] + 1e-9)

    # Volatility-Adjusted Sell/Buy Pressure (VASP)
    a.loc[:, 'VASP_sell'] = a['sell_value'] / (a['volatility_trade'] + 1e-9)
    a.loc[:, 'VASP_buy'] = a['buy_value'] / (a['volatility_trade'] + 1e-9)

    # Burst: speed relative to long-term mean (short / long windows)
    a.loc[:, 'buy_speed'] = (a['buy_vol'] / a['mean_dt'].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    a.loc[:, 'sell_speed'] = (a['sell_vol'] / a['mean_dt'].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    a.loc[:, 'buy_speed_long_mean'] = a['buy_speed'].rolling(W_LONG, min_periods=1).mean()
    a.loc[:, 'sell_speed_long_mean'] = a['sell_speed'].rolling(W_LONG, min_periods=1).mean()

    a.loc[:, 'buy_burst'] = a['buy_speed'] / (a['buy_speed_long_mean'] + 1e-9)
    a.loc[:, 'sell_burst'] = a['sell_speed'] / (a['sell_speed_long_mean'] + 1e-9)

    # Volatility-Adjusted Sell Burst (VSB) - NEW
    a.loc[:, 'VSB'] = a['sell_speed'] / (a['volatility_trade'] + 1e-9)
    a.loc[:, 'VSB_buy'] = a['buy_speed'] / (a['volatility_trade'] + 1e-9)

    # Sell/Buy Imbalance Ratio (SIR)
    a.loc[:, 'SIR_sell'] = a['sell_vol'] / (a['buy_vol'] + 1e-9)
    a.loc[:, 'SIR_buy'] = a['buy_vol'] / (a['sell_vol'] + 1e-9)

    # Trade-Count Pressure (TCP) = volume per trade (captures many small sells)
    a.loc[:, 'TCP_sell'] = a['sell_vol'] / (a['trade_count'] + 1e-9)
    a.loc[:, 'TCP_buy'] = a['buy_vol'] / (a['trade_count'] + 1e-9)

    # Micro Liquidity Stress (MLS): price move over sell volume
    a.loc[:, 'MLS_sell'] = (a['close'] - a['open']).abs() / (a['sell_vol'] + 1e-9)
    a.loc[:, 'MLS_buy'] = (a['close'] - a['open']).abs() / (a['buy_vol'] + 1e-9)

    # Fill inf/nans
    a = a.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return a

# -----------------------
# Rolling percentile-based detector (buyers) with microstructure enhancement
# -----------------------
def detect_buyer_sessions_sensitive(agg15):
    a = agg15.copy()
    # ensure base columns
    for c in ['buy_vol','buy_value','OFI','CVD','PI','delta','mean_dt','volatility_trade','trade_count']:
        if c not in a.columns:
            a.loc[:, c] = 0.0

    # Add microstructure features
    a = add_micro_features(a)

    # core rolling features (existing)
    a.loc[:, 'buy_speed_ma'] = a['buy_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'sell_speed_ma'] = a['sell_speed'].rolling(W_SHORT, min_periods=1).mean()
    a.loc[:, 'VDM_roll'] = a['buy_speed_ma'] / (a['sell_speed_ma'] + 1e-9)
    a.loc[:, 'CVD_roll_slope_med'] = a['CVD'].rolling(W_MED, min_periods=1).apply(lambda s: s.iloc[-1] - s.iloc[0])

    # z-normalize core features on long baseline
    core_cols = ['buy_vol','buy_value','OFI','CVD_roll_slope_med','VDM_roll']
    for col in core_cols:
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    # core composite (original)
    a.loc[:, 'buyer_score_roll_core'] = (
        0.4 * a['buy_value_zn_roll'] +
        0.25 * a['buy_vol_zn_roll'] +
        0.2 * a['OFI_zn_roll'] +
        0.1 * a['CVD_roll_slope_med_zn_roll'] +
        0.05 * a['VDM_roll_zn_roll']
    )

    # microstructure enhancements for BUYERS
    micro_cols_buy = [
        'ATD_norm', 'ATD_vol_adj', 'ATVD_norm', 'ATVD_vol_adj',
        'VASP_buy', 'VSB_buy',
        'buy_burst', 'SIR_buy', 'TCP_buy', 'MLS_buy'
    ]
    for col in micro_cols_buy:
        if col not in a.columns:
            a.loc[:, col] = 0.0
        roll_mean = a[col].rolling(W_LONG, min_periods=1).mean()
        roll_std = a[col].rolling(W_LONG, min_periods=1).std().replace(0, np.nan)
        a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)

    enh_cols = [c + '_zn_roll' for c in micro_cols_buy]
    if len(enh_cols) > 0:
        a.loc[:, 'buyer_micro_enhancement'] = a[enh_cols].mean(axis=1).fillna(0.0)
    else:
        a.loc[:, 'buyer_micro_enhancement'] = 0.0

    # final roll: blend core and enhancement
    a.loc[:, 'buyer_score_roll'] = 0.8 * a['buyer_score_roll_core'] + 0.2 * a['buyer_micro_enhancement']

    # EWM smoothing and thresholding
    a.loc[:, 'buyer_score_ewm'] = a['buyer_score_roll'].ewm(span=EWM_SPAN, adjust=False).mean()
    a.loc[:, 'threshold_strong'] = a['buyer_score_ewm'].rolling(W_LONG, min_periods=1).quantile(STRONG_Q)
    a.loc[:, 'threshold_soft'] = a['buyer_score_ewm'].rolling(W_LONG, min_periods=1).quantile(SOFT_Q)
    a.loc[:, 'is_buyer_strong'] = a['buyer_score_ewm'] > a['threshold_strong']
    a.loc[:, 'is_buyer_soft'] = a['buyer_score_ewm'] > a['threshold_soft']
    a.loc[:, 'is_buyer_window_final'] = a['is_buyer_strong'] | a['is_buyer_soft']

    # sessions
    a.loc[:, 'session_id_final'] = (a['is_buyer_window_final'] != a['is_buyer_window_final'].shift(1)).cumsum()
    sessions = []
    for sid, g in a.groupby('session_id_final'):
        if not g['is_buyer_window_final'].iloc[0]:
            continue
        start_ts, end_ts = g.index.min(), g.index.max()
        duration_min = (end_ts - start_ts) / pd.Timedelta(minutes=1)
        sessions.append({
            'start': start_ts,
            'end': end_ts,
            'duration_min': float(duration_min),
            'max_buyer_score_ewm': float(g['buyer_score_ewm'].max()),
            'mean_OFI': float(g['OFI'].mean()),
            'total_buy_value': float(g['buy_value'].sum()),
            'total_buy_vol': float(g['buy_vol'].sum()),
            'avg_PI': float(g['PI'].mean()),
            'is_strong_session': bool(g['is_buyer_strong'].any()),
            'is_soft_session': bool(g['is_buyer_soft'].any())
        })

    return a, pd.DataFrame(sessions)

