def detect_anomalies_in_bars(agg_df, timeframe_name):
    """
    Detects anomalous bars (flash crashes, fat fingers, etc.)
    """
    if len(agg_df) < 2:
        return agg_df
    
    agg_df['is_anomaly'] = False
    
    # 1. Price spike detection
    if 'close' in agg_df.columns:
        price_changes = agg_df['close'].pct_change().abs()
        price_mean = price_changes.mean()
        price_std = price_changes.std()
        
        price_anomalies = price_changes > (price_mean + PRICE_SIGMA_THRESHOLD * price_std)
        agg_df.loc[price_anomalies, 'is_anomaly'] = True
    
    # 2. Volume spike detection
    if 'volume' in agg_df.columns:
        vol_mean = agg_df['volume'].rolling(20, min_periods=1).mean()
        vol_spikes = agg_df['volume'] > (vol_mean * VOLUME_SPIKE_THRESHOLD)
        agg_df.loc[vol_spikes, 'is_anomaly'] = True
    
    anomaly_count = agg_df['is_anomaly'].sum()
    if anomaly_count > 0:
        quality_report.metrics['anomalies_detected'] += anomaly_count
        quality_report.add_warning(
            f"{timeframe_name}: {anomaly_count} anomalous bars detected"
        )
    
    return agg_df

