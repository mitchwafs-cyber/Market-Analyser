def compute_base_features(df):
    """Enhanced base feature computation with validation"""
    df = df.copy()
    if 'timestamp' not in df.columns:
        df.loc[:, 'timestamp'] = pd.to_datetime(df['transact_time'], unit='ms')
    df = df.sort_values('timestamp').reset_index(drop=True)

    # Buyer/Seller classification with validation
    if 'is_buyer_maker' in df.columns and 'quantity' in df.columns:
        # Handle potential nulls
        df['is_buyer_maker'] = df['is_buyer_maker'].fillna(False)
        
        # Classify trades
        df.loc[:, 'buy_vol'] = np.where(df['is_buyer_maker'] == False, df['quantity'], 0.0)
        df.loc[:, 'sell_vol'] = np.where(df['is_buyer_maker'] == True, df['quantity'], 0.0)
        
        # Validate classification
        validate_buyer_seller_classification(df)
    else:
        df.loc[:, 'buy_vol'] = 0.0
        df.loc[:, 'sell_vol'] = 0.0
        quality_report.add_warning("is_buyer_maker column missing - cannot classify trades")

    if 'price' in df.columns:
        df.loc[:, 'buy_value'] = df['buy_vol'] * df['price']
        df.loc[:, 'sell_value'] = df['sell_vol'] * df['price']
    else:
        df.loc[:, 'buy_value'] = 0.0
        df.loc[:, 'sell_value'] = 0.0

    df.loc[:, 'dt'] = df['timestamp'].diff().dt.total_seconds().fillna(0.0)
    
    return df

