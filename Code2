def resample_bars(df, rule='15min'):
    """Enhanced resampling with explicit boundary handling"""
    df = df.copy()
    g = df.set_index('timestamp')
    for c in ['price','quantity','buy_vol','sell_vol','buy_value','sell_value','dt','volatility_trade']:
        if c not in g:
            g.loc[:, c] = 0.0

    # Use label='right', closed='right' for consistent boundary handling
    agg = g.resample(rule, label='right', closed='right').agg({
        'price': ['first','last','max','min'],
        'quantity': 'sum',
        'buy_vol': 'sum',
        'sell_vol': 'sum',
        'buy_value': 'sum',
        'sell_value': 'sum',
        'dt': 'mean',
        'volatility_trade': 'mean'
    })
    agg.columns = ['open','close','high','low','volume','buy_vol','sell_vol','buy_value','sell_value','mean_dt','volatility_trade']

    # derived
    agg['delta'] = agg['buy_vol'] - agg['sell_vol']
    agg['total_vol'] = agg['buy_vol'] + agg['sell_vol']
    agg['OFI'] = agg['delta'] / agg['total_vol'].replace(0, np.nan)
    agg['buy_imbalance_pct'] = 100 * (agg['buy_vol'] / agg['total_vol'].replace(0, np.nan))
    agg['CVD'] = agg['delta'].cumsum()
    agg['PI'] = (agg['close'] - agg['open']).abs() / (agg['delta'].abs() + 1e-9)
    agg['Absorption'] = agg['delta'].abs() / ((agg['close'] - agg['open']).abs() + 1e-9)
    agg['trade_count'] = g['price'].resample(rule, label='right', closed='right').count()
    agg = agg.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    # Add bar start/end times for reference
    agg['bar_start'] = agg.index
    agg['bar_end'] = agg.index + pd.Timedelta(rule)
    
    return agg

def multi_timeframe_resample(df):
    """Enhanced multi-timeframe resampling with validation"""
    print("\n" + "="*80)
    print("STEP 2: MULTI-TIMEFRAME RESAMPLING")
    print("="*80)
    
    results = {}
    for name, rule in [('1min','1min'), ('5min','5min'), ('15min','15min'), ('1h','1h'), ('4h','4h')]:
        print(f"\n🔄 Resampling to {name}...")
        results[name] = resample_bars(df, rule)
        print(f"   • Created {len(results[name])} bars")
        print(f"   • Time range: {results[name].index.min()} to {results[name].index.max()}")
        
        # Detect low confidence bars
        results[name] = detect_low_confidence_bars(results[name], name)
        
        # Detect anomalies
        results[name] = detect_anomalies_in_bars(results[name], name)
        
        # Apply warmup period marking
        results[name] = apply_warmup_period(results[name], WARMUP_BARS)
    
    # Validate volume conservation
    validate_volume_conservation(df, results)
    
    return results

