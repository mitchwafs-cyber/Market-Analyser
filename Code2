    if 'price' in df.columns and 'quantity' in df.columns:
        before_filter = len(df)
        df = df[(df['price'] > 0) & (df['quantity'] > 0)].copy()
        removed = before_filter - len(df)
        if removed > 0:
            quality_report.add_warning(f"Removed {removed} trades with invalid price/quantity")
    
    # Clip extreme price outliers (keep track of what's removed)
    if 'price' in df.columns:
        pm = df['price'].mean()
