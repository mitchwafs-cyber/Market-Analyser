        'top_resistance': resistance,
        'high_volume_zones': high_volume,
        'high_value_zones': high_value,
        'reversal_zones': reversal
    }

def analyze_price_magnets(zones_df, results_dict):
    """
    Identifies price magnets - levels that repeatedly attract price action.
    Enhanced to include timestamps, comparative zones, and minimum count validation.
    
    Note: price_zone represents the zone bin center (e.g., 90.0 for bin 90-100),
    while price_min and price_max columns contain the exact minimum and maximum
    prices observed within each zone during the analysis period.
    """
    print("\n" + "="*80)
    print("ANALYZING PRICE MAGNETS & ATTRACTION ZONES")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        print("⚠️  No zone data available for magnet analysis")
        return pd.DataFrame()
    
    df = zones_df.copy()
    
    # Validation: Check for minimum zones
    MIN_ZONES_REQUIRED = 5
    if len(df) < MIN_ZONES_REQUIRED:
        print(f"⚠️  Insufficient zones ({len(df)}) for meaningful magnet analysis (minimum: {MIN_ZONES_REQUIRED})")
        print(f"   Returning all {len(df)} zones as potential magnets")
        # Return all zones with magnet_strength calculated
        df['magnet_strength'] = (
            0.40 * df['touch_score'] +
            0.30 * df['volume_score'] +
            0.30 * (1 - (df['buy_pressure_ratio'] - 0.5).abs() * 2)
        )
        df['aligned_with_buyers'] = df['buyer_score'] > df['seller_score']
        df['aligned_with_sellers'] = df['seller_score'] > df['buyer_score']
        df['magnet_quality_rating'] = 'LOW_DATA'
        return df.sort_values('magnet_strength', ascending=False)
    
    # Calculate magnet strength (combination of touches, volume, and reversion)
    df['magnet_strength'] = (
        0.40 * df['touch_score'] +
        0.30 * df['volume_score'] +
        0.30 * (1 - (df['buy_pressure_ratio'] - 0.5).abs() * 2)  # Higher for neutral zones
    )
    
    # Adaptive threshold: use 0.80 quantile but ensure minimum count
    magnet_threshold = df['magnet_strength'].quantile(0.80)
    magnets = df[df['magnet_strength'] >= magnet_threshold].copy()
    
    # Ensure at least 3 magnets if we have enough zones
    if len(magnets) < 3 and len(df) >= 3:
        print(f"   Adjusting threshold to ensure minimum magnet count")
        magnets = df.nlargest(min(3, len(df)), 'magnet_strength').copy()
    
    # Add session alignment
    magnets['aligned_with_buyers'] = magnets['buyer_score'] > magnets['seller_score']
    magnets['aligned_with_sellers'] = magnets['seller_score'] > magnets['buyer_score']
    
    # Add comparative zone context (zones above and below each magnet)
    magnets = magnets.sort_values('price_zone').reset_index(drop=True)
    magnets['zone_above'] = magnets['price_zone'].shift(-1)
    magnets['zone_below'] = magnets['price_zone'].shift(1)
    magnets['distance_to_zone_above'] = magnets['zone_above'] - magnets['price_zone']
    magnets['distance_to_zone_below'] = magnets['price_zone'] - magnets['zone_below']
    
    # Add zone position indicators
    magnets['is_highest_zone'] = magnets['price_zone'] == magnets['price_zone'].max()
    magnets['is_lowest_zone'] = magnets['price_zone'] == magnets['price_zone'].min()
    magnets['zone_rank'] = range(1, len(magnets) + 1)
    
    # Add timestamp information from results_dict if available
    # Extract earliest and latest timestamps from timeframe data
    earliest_time = None
    latest_time = None
    
    for tf_name in ['agg1m', 'agg5m', 'agg15m', 'agg1h', 'agg4h']:
        if tf_name in results_dict and results_dict[tf_name] is not None:
            tf_data = results_dict[tf_name]
            if not tf_data.empty and hasattr(tf_data.index, 'min'):
                tf_earliest = tf_data.index.min()
                tf_latest = tf_data.index.max()
                
                if earliest_time is None or tf_earliest < earliest_time:
                    earliest_time = tf_earliest
                if latest_time is None or tf_latest > latest_time:
                    latest_time = tf_latest
    
    # Add timestamp metadata to magnets
    if earliest_time is not None and latest_time is not None:
        magnets['analysis_period_start'] = earliest_time
        magnets['analysis_period_end'] = latest_time
        magnets['analysis_duration_hours'] = (latest_time - earliest_time).total_seconds() / 3600
    else:
        magnets['analysis_period_start'] = 'N/A'
        magnets['analysis_period_end'] = 'N/A'
        magnets['analysis_duration_hours'] = 0
    
    # Add data quality rating
    def rate_magnet_quality(row):
        """Rate the quality of magnet data on a 1-10 scale"""
        score = 5  # Start at middle
        
        # High touch count is good (+2)
        if row.get('touch_count', 0) >= 10:
            score += 2
        elif row.get('touch_count', 0) >= 5:
            score += 1
        
        # High volume is good (+2)
        if row.get('volume_score', 0) >= 0.7:
            score += 2
        elif row.get('volume_score', 0) >= 0.5:
            score += 1
        
        # Has comparative zones (+1)
        if pd.notna(row.get('zone_above')) and pd.notna(row.get('zone_below')):
            score += 1
        
        return min(10, score)
    
    magnets['magnet_quality_rating'] = magnets.apply(rate_magnet_quality, axis=1)
    
    # Sort by magnet strength
    magnets = magnets.sort_values('magnet_strength', ascending=False)
    
    # Calculate summary statistics
    avg_quality = magnets['magnet_quality_rating'].mean()
    
    print(f"✓ Identified {len(magnets)} price magnet zones")
    print(f"  • Buyer-aligned magnets: {magnets['aligned_with_buyers'].sum()}")
    print(f"  • Seller-aligned magnets: {magnets['aligned_with_sellers'].sum()}")
    print(f"  • Average quality rating: {avg_quality:.1f}/10")
    print(f"  • Price range: ${magnets['price_zone'].min():.2f} - ${magnets['price_zone'].max():.2f}")
    if earliest_time is not None:
        print(f"  • Analysis period: {earliest_time} to {latest_time}")
    
    # Warning if quality is low
    if avg_quality < 5:
        print(f"  ⚠️  Low average quality rating ({avg_quality:.1f}/10) - limited data for zone analysis")
    
    return magnets

def create_zone_hierarchy(zones_df):
    """
    Creates a hierarchical view of zones by importance.
    """
    print("\n" + "="*80)
    print("CREATING ZONE HIERARCHY")
    print("="*80)
    
    if zones_df is None or zones_df.empty:
        return pd.DataFrame()
    
    df = zones_df.copy()
    
    # Warning if very few zones
    if len(df) <= 3:
        print(f"⚠️  Only {len(df)} zone(s) - hierarchy analysis limited\n")
    
    # Define tiers based on importance score
    # Handle single-zone edge case where quantiles would be identical
    if len(df) == 1:
        # Single zone: always assign to TIER_1_CRITICAL
        df['tier'] = 'TIER_1_CRITICAL'
    elif len(df) == 2:
        # Two zones: assign based on which is higher
        median_score = df['importance_score'].median()
        df['tier'] = df['importance_score'].apply(
            lambda x: 'TIER_1_CRITICAL' if x >= median_score else 'TIER_2_IMPORTANT'
        )
    else:
        # Three or more zones: use quantile-based assignment
        importance_q66 = df['importance_score'].quantile(0.66)
        importance_q33 = df['importance_score'].quantile(0.33)
        
        def assign_tier(score):
            if score >= importance_q66:
                return 'TIER_1_CRITICAL'
            elif score >= importance_q33:
                return 'TIER_2_IMPORTANT'
            else:
                return 'TIER_3_MINOR'
        
        df['tier'] = df['importance_score'].apply(assign_tier)
    
    # Count by tier and type
    hierarchy = df.groupby(['tier', 'zone_type']).agg({
        'price_zone': 'count',
        'volume': 'sum',
        'total_value': 'sum',
        'importance_score': 'mean'
    }).reset_index()
    
    hierarchy.columns = ['tier', 'zone_type', 'zone_count', 'total_volume', 'total_value', 'avg_importance']
    
    print("\n📊 Zone Hierarchy:")
    for tier in ['TIER_1_CRITICAL', 'TIER_2_IMPORTANT', 'TIER_3_MINOR']:
        tier_data = hierarchy[hierarchy['tier'] == tier]
        if not tier_data.empty:
            print(f"\n  {tier}:")
            for _, row in tier_data.iterrows():
                print(f"    • {row['zone_type']}: {int(row['zone_count'])} zones, "
                      f"Volume: {row['total_volume']:,.0f}, "
                      f"Value: ${row['total_value']:,.0f}")
    
    return df

