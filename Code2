def add_all_features_to_timeframe(agg, timeframe_name=''):
    """
    Complete feature engineering pipeline with proper window requirements.
    Uses appropriate min_periods to ensure data sufficiency.
    """
    a = agg.copy()
    
    print(f"\n🔧 Engineering features for {timeframe_name}...")
    
    # Ensure base columns exist
    for c in ['buy_vol','buy_value','sell_vol','sell_value','OFI','CVD','PI','delta','mean_dt','volatility_trade','trade_count','open','close','high','low']:
        if c not in a.columns:
            a.loc[:, c] = 0.0
    
    # 1. Add microstructure features
    a = add_micro_features(a)
    
    # 2. Add rolling features with PROPER min_periods
    # Use min_periods=max(1, window//2) for reliability
    a.loc[:, 'buy_speed_ma'] = a['buy_speed'].rolling(W_SHORT, min_periods=max(1, W_SHORT//2)).mean()
    a.loc[:, 'sell_speed_ma'] = a['sell_speed'].rolling(W_SHORT, min_periods=max(1, W_SHORT//2)).mean()
    a.loc[:, 'VDM_roll'] = a['buy_speed_ma'] / (a['sell_speed_ma'] + 1e-9)
    
    # Slopes with proper windows
    a.loc[:, 'CVD_roll_slope_short'] = a['CVD'].rolling(W_SHORT, min_periods=max(2, W_SHORT//2)).apply(
        lambda s: s.iloc[-1] - s.iloc[0] if len(s) > 1 else 0, raw=False
    )
    a.loc[:, 'CVD_roll_slope_med'] = a['CVD'].rolling(W_MED, min_periods=max(2, W_MED//2)).apply(
        lambda s: s.iloc[-1] - s.iloc[0] if len(s) > 1 else 0, raw=False
    )
    a.loc[:, 'CVD_roll_slope_long'] = a['CVD'].rolling(W_LONG, min_periods=max(2, W_LONG//2)).apply(
        lambda s: s.iloc[-1] - s.iloc[0] if len(s) > 1 else 0, raw=False
    )
    
    # 3. Z-normalize core features with PROPER min_periods
    core_cols = ['buy_vol','buy_value','sell_vol','sell_value','OFI','CVD_roll_slope_med','VDM_roll']
    for col in core_cols:
        if col in a.columns:
            roll_mean = a[col].rolling(W_LONG, min_periods=W_LONG).mean()  # CHANGED: require full window
            roll_std = a[col].rolling(W_LONG, min_periods=W_LONG).std().replace(0, np.nan)
            a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)
    
    # 4. Buyer composite score
    a.loc[:, 'buyer_score_roll_core'] = (
        0.4 * a.get('buy_value_zn_roll', 0.0) +
        0.25 * a.get('buy_vol_zn_roll', 0.0) +
        0.2 * a.get('OFI_zn_roll', 0.0) +
        0.1 * a.get('CVD_roll_slope_med_zn_roll', 0.0) +
        0.05 * a.get('VDM_roll_zn_roll', 0.0)
    )
    
    # 5. Microstructure enhancement for buyers
    micro_cols_buy = ['ATD_norm', 'ATD_vol_adj', 'ATVD_norm', 'ATVD_vol_adj',
                      'VASP_buy', 'VSB_buy', 'buy_burst', 'SIR_buy', 'TCP_buy', 'MLS_buy']
    for col in micro_cols_buy:
        if col in a.columns:
            roll_mean = a[col].rolling(W_LONG, min_periods=W_LONG).mean()
            roll_std = a[col].rolling(W_LONG, min_periods=W_LONG).std().replace(0, np.nan)
            a[col + '_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)
    
    enh_cols_buy = [c + '_zn_roll' for c in micro_cols_buy if c + '_zn_roll' in a.columns]
    if len(enh_cols_buy) > 0:
        a.loc[:, 'buyer_micro_enhancement'] = a[enh_cols_buy].mean(axis=1).fillna(0.0)
    else:
        a.loc[:, 'buyer_micro_enhancement'] = 0.0
    
    a.loc[:, 'buyer_score_roll'] = 0.8 * a['buyer_score_roll_core'] + 0.2 * a['buyer_micro_enhancement']
    a.loc[:, 'buyer_score_ewm'] = a['buyer_score_roll'].ewm(span=EWM_SPAN, adjust=False, min_periods=EWM_SPAN).mean()
    
    # 6. Seller composite score
    a.loc[:, 'VDM_roll_seller'] = a['sell_speed_ma'] / (a['buy_speed_ma'] + 1e-9)
    
    seller_core_cols = ['sell_vol','sell_value','OFI','CVD_roll_slope_med','VDM_roll_seller']
    for col in seller_core_cols:
        if col in a.columns:
            roll_mean = a[col].rolling(W_LONG, min_periods=W_LONG).mean()
            roll_std = a[col].rolling(W_LONG, min_periods=W_LONG).std().replace(0, np.nan)
            a[col + '_seller_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)
    
    a.loc[:, 'seller_score_roll_core'] = (
        0.4 * a.get('sell_value_seller_zn_roll', 0.0) +
        0.25 * a.get('sell_vol_seller_zn_roll', 0.0) +
        0.2 * a.get('OFI_seller_zn_roll', 0.0) +
        0.1 * a.get('CVD_roll_slope_med_seller_zn_roll', 0.0) +
        0.05 * a.get('VDM_roll_seller_seller_zn_roll', 0.0)
    )
    
    # 7. Microstructure enhancement for sellers
    micro_cols_sell = ['ATD_norm', 'ATD_vol_adj', 'ATVD_norm', 'ATVD_vol_adj',
                       'VASP_sell', 'VSB', 'sell_burst', 'SIR_sell', 'TCP_sell', 'MLS_sell']
    for col in micro_cols_sell:
        if col in a.columns:
            roll_mean = a[col].rolling(W_LONG, min_periods=W_LONG).mean()
            roll_std = a[col].rolling(W_LONG, min_periods=W_LONG).std().replace(0, np.nan)
            a[col + '_seller_zn_roll'] = ((a[col] - roll_mean) / (roll_std + 1e-9)).fillna(0.0)
    
    enh_cols_sell = [c + '_seller_zn_roll' for c in micro_cols_sell if c + '_seller_zn_roll' in a.columns]
    if len(enh_cols_sell) > 0:
        a.loc[:, 'seller_micro_enhancement'] = a[enh_cols_sell].mean(axis=1).fillna(0.0)
    else:
        a.loc[:, 'seller_micro_enhancement'] = 0.0
    
    a.loc[:, 'seller_score_roll'] = 0.8 * a['seller_score_roll_core'] + 0.2 * a['seller_micro_enhancement']
    a.loc[:, 'seller_score_ewm'] = a['seller_score_roll'].ewm(span=EWM_SPAN, adjust=False, min_periods=EWM_SPAN).mean()
    
    # 8. Price-based features
    a.loc[:, 'price_range'] = a['high'] - a['low']
    a.loc[:, 'price_change_pct'] = ((a['close'] - a['open']) / a['open'].replace(0, np.nan) * 100).fillna(0.0)
    a.loc[:, 'hl_ratio'] = a['high'] / a['low'].replace(0, np.nan)
    a.loc[:, 'body_size'] = (a['close'] - a['open']).abs()
    a.loc[:, 'upper_wick'] = a['high'] - a[['open','close']].max(axis=1)
    a.loc[:, 'lower_wick'] = a[['open','close']].min(axis=1) - a['low']
    
    # 9. Volume-weighted metrics
    a.loc[:, 'VWAP'] = (a['buy_value'] + a['sell_value']) / (a['buy_vol'] + a['sell_vol']).replace(0, np.nan)
    a.loc[:, 'volume_price_trend'] = a['volume'] * a['price_change_pct']
    a.loc[:, 'buy_sell_ratio'] = a['buy_vol'] / a['sell_vol'].replace(0, np.nan)
    
    # 10. Momentum indicators
    a.loc[:, 'momentum_3'] = a['close'].diff(3).fillna(0.0)
    a.loc[:, 'momentum_8'] = a['close'].diff(8).fillna(0.0)
    a.loc[:, 'ROC_3'] = ((a['close'] - a['close'].shift(3)) / a['close'].shift(3).replace(0, np.nan) * 100).fillna(0.0)
    
    # 11. Volatility metrics
    a.loc[:, 'volatility_short'] = a['close'].pct_change().rolling(W_SHORT, min_periods=max(2, W_SHORT//2)).std().fillna(0.0)
    a.loc[:, 'volatility_long'] = a['close'].pct_change().rolling(W_LONG, min_periods=max(2, W_LONG//2)).std().fillna(0.0)
    a.loc[:, 'ATR_proxy'] = a['price_range'].rolling(W_SHORT, min_periods=max(1, W_SHORT//2)).mean()
    
    # 12. Clean up infinities and NaNs
    a = a.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    
    # 13. Add reliability score based on warmup and confidence
    a['reliability_score'] = 1.0
    if 'is_warmup' in a.columns:
        a.loc[a['is_warmup'] == True, 'reliability_score'] = 0.3  # Low reliability during warmup
    if 'data_confidence' in a.columns:
        a.loc[a['data_confidence'] == 'LOW', 'reliability_score'] *= 0.5
        a.loc[a['data_confidence'] == 'MEDIUM', 'reliability_score'] *= 0.75
    if 'is_anomaly' in a.columns:
        a.loc[a['is_anomaly'] == True, 'reliability_score'] *= 0.6  # Reduce reliability for anomalies
    
    print(f"  ✓ Added {len(a.columns)} features")
    print(f"  ✓ Reliable bars (score > 0.8): {(a['reliability_score'] > 0.8).sum()} / {len(a)}")
    
    return a

