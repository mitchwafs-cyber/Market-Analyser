            'Metric': ['Average Session Duration (min)','Average Volume','Soft Session Rate','Strong Session Rate'],
            'Value': [0,0,0,0]
        })
    vol_col = 'total_buy_vol' if 'total_buy_vol' in sessions_df.columns else ('total_sell_vol' if 'total_sell_vol' in sessions_df.columns else None)
    avg_vol = sessions_df[vol_col].mean() if vol_col in sessions_df.columns else 0
    return pd.DataFrame({
        'Metric': ['Average Session Duration (min)','Average Volume','Soft Session Rate','Strong Session Rate'],
        'Value': [
