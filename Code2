def save_feature_output(df, feature_name, output_folder):
    """
    Saves a separate CSV for each feature/tf AND appends to unified all_events.csv.
    This is safe for large pipelines and multi-timeframe outputs.
    """
    if df is None or (isinstance(df, pd.DataFrame) and df.empty):
        print(f"[SKIPPED] {feature_name} - empty dataframe")
        return
    
    df = df.copy()

    # --- 1. Folder creation ---
    os.makedirs(output_folder, exist_ok=True)

    # --- 2. Individual feature file ---
    file_path = os.path.join(output_folder, f"{feature_name}.csv")
    df.to_csv(file_path, index=True if isinstance(df.index, pd.DatetimeIndex) else False)

    # --- 3. Unified master file ---
    master_path = os.path.join(output_folder, "all_events.csv")

    # Add feature_name column for tracking in master file
    df_master = df.copy()
    if isinstance(df_master, pd.DataFrame):
        df_master['feature_source'] = feature_name

    if not os.path.exists(master_path):
        df_master.to_csv(master_path, index=False)
    else:
        df_master.to_csv(master_path, mode="a", header=False, index=False)

    print(f"[SAVED] {feature_name} → {file_path}")

