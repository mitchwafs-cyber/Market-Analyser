def extract_time_features(df):
    """
    Extract comprehensive time-based features from timestamps.
    Includes intraday sessions, cyclic encoding, and temporal patterns.
    """
    df = df.copy()
    
    if 'timestamp' not in df.columns:
        return df
    
    # Extract basic time components
    df['hour'] = df['timestamp'].dt.hour
    df['day_of_week'] = df['timestamp'].dt.dayofweek  # 0=Monday, 6=Sunday
    df['day_of_month'] = df['timestamp'].dt.day
    df['month'] = df['timestamp'].dt.month
    
    # Cyclic encoding for hour (24-hour cycle)
    df['hour_sin'] = np.sin(2 * np.pi * df['hour'] / 24)
    df['hour_cos'] = np.cos(2 * np.pi * df['hour'] / 24)
    
    # Cyclic encoding for day of week (7-day cycle)
    df['dow_sin'] = np.sin(2 * np.pi * df['day_of_week'] / 7)
    df['dow_cos'] = np.cos(2 * np.pi * df['day_of_week'] / 7)
    
    # Intraday session classification (UTC-based, adjust if needed)
    # Asian: 00:00-08:00, European: 08:00-16:00, US: 16:00-20:00, Late_US: 20:00-00:00
    df['session'] = 'Unknown'
    df.loc[(df['hour'] >= 0) & (df['hour'] < 8), 'session'] = 'Asian'
    df.loc[(df['hour'] >= 8) & (df['hour'] < 16), 'session'] = 'European'
    df.loc[(df['hour'] >= 16) & (df['hour'] < 20), 'session'] = 'US'
    df.loc[(df['hour'] >= 20) & (df['hour'] < 24), 'session'] = 'Late_US'
    
    # Weekend effect
    df['is_weekend'] = (df['day_of_week'] >= 5).astype(int)
    
    return df


def calculate_trade_velocity_acceleration(df):
    """
    Calculate trade velocity and acceleration metrics.
    Velocity = change in price / time delta
    Acceleration = change in velocity / time delta
    """
    df = df.copy()
    
    if 'price' not in df.columns or 'dt' not in df.columns:
        df['trade_velocity'] = 0.0
        df['trade_acceleration'] = 0.0
        return df
    
    # Velocity: price change per second
    df['price_diff'] = df['price'].diff().fillna(0.0)
    df['trade_velocity'] = df['price_diff'] / (df['dt'] + 1e-9)
    df['trade_velocity'] = df['trade_velocity'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    
    # Acceleration: change in velocity per second
    df['velocity_diff'] = df['trade_velocity'].diff().fillna(0.0)
    df['trade_acceleration'] = df['velocity_diff'] / (df['dt'] + 1e-9)
    df['trade_acceleration'] = df['trade_acceleration'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    
    return df


def calculate_price_impact_metrics(df):
    """
    Calculate price impact per unit volume and directional impact.
    Price impact = |price change| / volume
    Signed impact = signed price change / volume
    """
    df = df.copy()
    
    if 'price' not in df.columns or 'quantity' not in df.columns:
        df['price_impact'] = 0.0
        df['signed_price_impact'] = 0.0
        df['price_impact_bps'] = 0.0
        return df
    
    # Price change (absolute and signed)
    df['price_change_abs'] = df['price'].diff().abs().fillna(0.0)
    df['price_change_signed'] = df['price'].diff().fillna(0.0)
    
    # Price impact per unit volume
    df['price_impact'] = df['price_change_abs'] / (df['quantity'] + 1e-9)
    df['signed_price_impact'] = df['price_change_signed'] / (df['quantity'] + 1e-9)
    
    # Price impact in basis points (bps)
    df['price_impact_bps'] = (df['price_change_abs'] / (df['price'].shift(1) + 1e-9) * 10000).fillna(0.0)
    
    # Replace infinities
    df['price_impact'] = df['price_impact'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    df['signed_price_impact'] = df['signed_price_impact'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    df['price_impact_bps'] = df['price_impact_bps'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    
    # Cumulative price impact (rolling sum over last 100 trades)
    df['cumulative_price_impact'] = df['price_impact'].rolling(100, min_periods=1).sum()
    
    return df


def estimate_spread_from_trades(df):
    """
    Estimate bid-ask spread using Lee-Ready algorithm.
    Uses the tick rule: if trade price > previous, it's a buy; if <, it's a sell.
    Effective spread = 2 * |trade_price - midpoint|
    """
    df = df.copy()
    
    if 'price' not in df.columns:
        df['estimated_spread'] = 0.0
        df['estimated_spread_bps'] = 0.0
        df['midpoint_estimate'] = 0.0
        return df
    
    # Estimate midpoint as rolling average of last few trades
    df['midpoint_estimate'] = df['price'].rolling(5, min_periods=1).mean()
    
    # Effective spread estimate
    df['estimated_spread'] = 2 * (df['price'] - df['midpoint_estimate']).abs()
    
    # Spread in basis points
    df['estimated_spread_bps'] = (df['estimated_spread'] / (df['midpoint_estimate'] + 1e-9) * 10000).fillna(0.0)
    df['estimated_spread_bps'] = df['estimated_spread_bps'].replace([np.inf, -np.inf], 0.0)
    
    # Tick direction for Lee-Ready
    df['tick_direction'] = 0
    price_diff = df['price'].diff()
    df.loc[price_diff > 0, 'tick_direction'] = 1  # Uptick = buy
    df.loc[price_diff < 0, 'tick_direction'] = -1  # Downtick = sell
    df.loc[price_diff == 0, 'tick_direction'] = df['tick_direction'].shift(1).fillna(0)  # Zero-tick rule
    
    return df


def calculate_microstructure_noise(df):
    """
    Quantify market microstructure noise using bid-ask bounce and autocovariance.
    Noise ratio = -autocovariance(returns) / variance(returns)
    """
    df = df.copy()
    
    if 'price' not in df.columns:
        df['microstructure_noise'] = 0.0
        df['bid_ask_bounce'] = 0.0
        return df
    
    # Calculate returns
    df['return'] = df['price'].pct_change().fillna(0.0)
    
    # Rolling autocovariance (lag-1)
    window = 100
    df['autocov'] = df['return'].rolling(window, min_periods=2).apply(
        lambda x: x.autocorr(lag=1) if len(x) > 1 else 0, raw=False
    ).fillna(0.0)
    
    # Microstructure noise ratio (negative autocorrelation indicates bid-ask bounce)
    df['microstructure_noise'] = -df['autocov']
    df['microstructure_noise'] = df['microstructure_noise'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    
    # Bid-ask bounce indicator (high negative autocorrelation)
    df['bid_ask_bounce'] = (df['autocov'] < -0.1).astype(int)
    
    return df


def analyze_trade_size_distribution(df):
    """
    Classify trades by size into categories:
    XS_Retail, S_Retail, M_Retail, L_Retail, Small_Whale, Medium_Whale, Large_Whale, Mega_Whale
    Calculate institutional footprint score.
    """
    df = df.copy()
    
    if 'quantity' not in df.columns:
        df['size_category'] = 'Unknown'
        df['is_institutional'] = 0
        df['institutional_score'] = 0.0
        size_metrics = pd.DataFrame()
        return df, size_metrics
    
    # Calculate percentiles for size classification
    q10 = df['quantity'].quantile(0.10)
    q25 = df['quantity'].quantile(0.25)
    q50 = df['quantity'].quantile(0.50)
    q75 = df['quantity'].quantile(0.75)
    q90 = df['quantity'].quantile(0.90)
    q95 = df['quantity'].quantile(0.95)
    q99 = df['quantity'].quantile(0.99)
    q999 = df['quantity'].quantile(0.999)
    
    # Size categorization
    df['size_category'] = 'M_Retail'  # Default
    df.loc[df['quantity'] <= q10, 'size_category'] = 'XS_Retail'
    df.loc[(df['quantity'] > q10) & (df['quantity'] <= q25), 'size_category'] = 'S_Retail'
    df.loc[(df['quantity'] > q25) & (df['quantity'] <= q50), 'size_category'] = 'M_Retail'
    df.loc[(df['quantity'] > q50) & (df['quantity'] <= q75), 'size_category'] = 'L_Retail'
    df.loc[(df['quantity'] > q75) & (df['quantity'] <= q90), 'size_category'] = 'Small_Whale'
    df.loc[(df['quantity'] > q90) & (df['quantity'] <= q95), 'size_category'] = 'Medium_Whale'
    df.loc[(df['quantity'] > q95) & (df['quantity'] <= q99), 'size_category'] = 'Large_Whale'
    df.loc[df['quantity'] > q99, 'size_category'] = 'Mega_Whale'
    
    # Institutional flag (whales)
    df['is_institutional'] = df['size_category'].isin(['Small_Whale', 'Medium_Whale', 'Large_Whale', 'Mega_Whale']).astype(int)
    
    # Institutional footprint score (rolling % of volume from whales)
    window = 100
    df['institutional_volume'] = df['quantity'] * df['is_institutional']
    df['institutional_score'] = (
        df['institutional_volume'].rolling(window, min_periods=1).sum() / 
        (df['quantity'].rolling(window, min_periods=1).sum() + 1e-9)
    ).fillna(0.0)
    
    # Create size distribution metrics
    size_metrics = df.groupby('size_category').agg({
        'quantity': ['count', 'sum', 'mean', 'std'],
        'buy_vol': 'sum',
        'sell_vol': 'sum'
    }).reset_index()
    
    size_metrics.columns = ['size_category', 'trade_count', 'total_volume', 'avg_size', 'std_size', 'buy_volume', 'sell_volume']
    size_metrics['volume_pct'] = 100 * size_metrics['total_volume'] / size_metrics['total_volume'].sum()
    size_metrics['trade_pct'] = 100 * size_metrics['trade_count'] / size_metrics['trade_count'].sum()
    
    return df, size_metrics


def analyze_trade_profitability(df, forward_periods=[1, 5, 10, 30]):
    """
    Analyze trade profitability by looking at price changes in future periods.
    This helps identify "smart money" vs "dumb money" trades.
    """
    df = df.copy()
    
    if 'price' not in df.columns or 'is_buyer_maker' not in df.columns:
        for period in forward_periods:
            df[f'profit_{period}'] = 0.0
            df[f'correct_direction_{period}'] = 0
        return df
    
    # Calculate forward returns for each period
    for period in forward_periods:
        df[f'price_fwd_{period}'] = df['price'].shift(-period)
        df[f'return_fwd_{period}'] = ((df[f'price_fwd_{period}'] - df['price']) / df['price'] * 100).fillna(0.0)
        
        # Profit calculation (positive if trade was in correct direction)
        # If buyer was taker (is_buyer_maker=False) and price went up, profit is positive
        # If seller was taker (is_buyer_maker=True) and price went down, profit is positive
        df[f'profit_{period}'] = np.where(
            df['is_buyer_maker'] == False,
            df[f'return_fwd_{period}'],  # Buyer profit
            -df[f'return_fwd_{period}']  # Seller profit
        )
        
        # Binary indicator: was the trade direction correct?
        df[f'correct_direction_{period}'] = (df[f'profit_{period}'] > 0).astype(int)
    
    # Calculate rolling win rate for smart money detection
    window = 100
    for period in forward_periods:
        df[f'win_rate_{period}'] = df[f'correct_direction_{period}'].rolling(window, min_periods=1).mean()
    
    return df


def detect_leader_follower_dynamics(df, window=50):
    """
    Detect leader-follower dynamics in trade flow.
    Leaders are trades that are followed by trades in the same direction.
    """
    df = df.copy()
    
    if 'is_buyer_maker' not in df.columns:
        df['is_leader'] = 0
        df['leader_score'] = 0.0
        return df
    
    # Define trade direction (1 = aggressive buy, -1 = aggressive sell)
    df['trade_direction'] = np.where(df['is_buyer_maker'] == False, 1, -1)
    
    # Count consecutive trades in same direction (momentum)
    df['direction_streak'] = 0
    streak = 0
    prev_direction = 0
    
    directions = df['trade_direction'].values
    streaks = np.zeros(len(df))
    
    for i in range(len(df)):
        if directions[i] == prev_direction:
            streak += 1
        else:
            streak = 1
            prev_direction = directions[i]
        streaks[i] = streak
    
    df['direction_streak'] = streaks
    
    # Leader detection: trades that initiate a streak of >= 5 trades
    df['is_leader'] = (df['direction_streak'] == 1) & (df['direction_streak'].shift(-4) >= 5)
    df['is_leader'] = df['is_leader'].fillna(False).astype(int)
    
    # Leader score (rolling % of leader trades)
    df['leader_score'] = df['is_leader'].rolling(window, min_periods=1).mean()
    
    return df


def extract_tape_reading_features(df):
    """
    Extract tape reading features: aggression patterns, size changes, pace.
    """
    df = df.copy()
    
    if 'quantity' not in df.columns or 'is_buyer_maker' not in df.columns:
        df['aggression_persistence'] = 0.0
        df['size_momentum'] = 0.0
        df['pace_acceleration'] = 0.0
        return df
    
    # Aggression persistence (rolling % of aggressive trades)
    window = 50
    df['is_aggressive'] = (df['is_buyer_maker'] == False).astype(int)  # Taker = aggressive
    df['aggression_persistence'] = df['is_aggressive'].rolling(window, min_periods=1).mean()
    
    # Size momentum (trend in trade sizes)
    df['size_change'] = df['quantity'].diff().fillna(0.0)
    df['size_momentum'] = df['size_change'].rolling(window, min_periods=1).mean()
    
    # Pace acceleration (change in trade frequency)
    df['trade_spacing'] = df['dt']  # Time between trades
    df['pace'] = 1.0 / (df['trade_spacing'] + 1e-9)  # Trades per second
    df['pace_change'] = df['pace'].diff().fillna(0.0)
    df['pace_acceleration'] = df['pace_change'].rolling(window, min_periods=1).mean()
    
    # Clean up
    df['pace'] = df['pace'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    df['pace_acceleration'] = df['pace_acceleration'].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    
    return df


