def validate_data_completeness(df):
    """
    Comprehensive data validation - checks for completeness, gaps, and integrity.
    """
    print("\n" + "="*80)
    print("STEP 1A: DATA COMPLETENESS VALIDATION")
    print("="*80)
    
    quality_report.metrics['raw_trades'] = len(df)
    
    # 1. Check required columns
    required_cols = ['timestamp', 'price', 'quantity']
    missing = [c for c in required_cols if c not in df.columns]
    if missing:
        quality_report.add_error(f"Missing required columns: {missing}")
        return False
    
    # 2. Check for nulls in critical columns
    for col in required_cols + ['is_buyer_maker']:
        if col in df.columns:
            null_count = df[col].isnull().sum()
            if null_count > 0:
                quality_report.metrics['null_values_found'] += null_count
                quality_report.add_warning(f"Found {null_count} null values in {col}")
    
    # 3. Timestamp continuity check
    df = df.sort_values('timestamp').reset_index(drop=True)
    time_diffs = df['timestamp'].diff().dt.total_seconds()
    
    # Find gaps
    gaps = time_diffs[time_diffs > MAX_GAP_SECONDS]
    if len(gaps) > 0:
        quality_report.metrics['timestamp_gaps'] = [
            {
                'index': idx,
                'gap_seconds': gap,
                'timestamp': df.loc[idx, 'timestamp']
            }
            for idx, gap in gaps.items()
        ]
        quality_report.add_warning(f"Found {len(gaps)} timestamp gaps > {MAX_GAP_SECONDS}s")
        
        # Print largest gaps
        largest_gaps = sorted(quality_report.metrics['timestamp_gaps'], 
                            key=lambda x: x['gap_seconds'], reverse=True)[:3]
        for g in largest_gaps:
            print(f"  • Gap of {g['gap_seconds']:.0f}s at {g['timestamp']}")
    else:
        print("✓ No significant timestamp gaps detected")
    
    # 4. Price sanity checks
    price_mean = df['price'].mean()
    price_std = df['price'].std()
    
    outliers = df[np.abs((df['price'] - price_mean) / price_std) > PRICE_SIGMA_THRESHOLD]
    if len(outliers) > 0:
        quality_report.add_warning(f"Found {len(outliers)} price outliers (>{PRICE_SIGMA_THRESHOLD} sigma)")
        print(f"  • Price range: {df['price'].min():.2f} - {df['price'].max():.2f}")
        print(f"  • Mean ± Std: {price_mean:.2f} ± {price_std:.2f}")
    else:
        print(f"✓ All prices within {PRICE_SIGMA_THRESHOLD} sigma")
    
    # 5. Volume sanity checks
    if 'quantity' in df.columns:
        zero_vol = (df['quantity'] <= 0).sum()
        if zero_vol > 0:
            quality_report.add_warning(f"Found {zero_vol} trades with zero/negative volume")
    
    # 6. is_buyer_maker validation
    if 'is_buyer_maker' in df.columns:
        invalid_maker = df[~df['is_buyer_maker'].isin([True, False, 0, 1])].shape[0]
        if invalid_maker > 0:
            quality_report.metrics['classification_errors'] = invalid_maker
            quality_report.add_error(f"Found {invalid_maker} invalid is_buyer_maker values")
    
    # 7. Time range validation
    time_span = df['timestamp'].max() - df['timestamp'].min()
    print(f"\n✓ Data time range: {df['timestamp'].min()} to {df['timestamp'].max()}")
    print(f"✓ Total span: {time_span}")
    print(f"✓ Average trade frequency: {len(df) / (time_span.total_seconds() / 60):.1f} trades/minute")
    
    return True

def validate_buyer_seller_classification(df):
    """
    Validates that buy_vol + sell_vol = quantity for each trade.
    """
    print("\n" + "="*80)
    print("STEP 1B: BUYER/SELLER CLASSIFICATION VALIDATION")
    print("="*80)
    
    if 'buy_vol' not in df.columns or 'sell_vol' not in df.columns:
        quality_report.add_warning("Cannot validate classification - buy_vol/sell_vol not yet computed")
        return True
    
    # Check volume conservation at trade level
    df['total_classified'] = df['buy_vol'] + df['sell_vol']
    
    # Allow small floating point differences
    tolerance = 1e-6
    mismatches = df[np.abs(df['total_classified'] - df['quantity']) > tolerance]
    
    if len(mismatches) > 0:
        quality_report.add_error(f"Volume classification mismatch in {len(mismatches)} trades")
        print(f"  Sample mismatch:")
        print(mismatches[['quantity', 'buy_vol', 'sell_vol', 'total_classified']].head())
        return False
    
    buy_count = (df['buy_vol'] > 0).sum()
    sell_count = (df['sell_vol'] > 0).sum()
    
    print(f"✓ All trades correctly classified")
    print(f"✓ Buy-side trades: {buy_count:,} ({buy_count/len(df)*100:.1f}%)")
    print(f"✓ Sell-side trades: {sell_count:,} ({sell_count/len(df)*100:.1f}%)")
    print(f"✓ Total buy volume: {df['buy_vol'].sum():,.2f}")
    print(f"✓ Total sell volume: {df['sell_vol'].sum():,.2f}")
    
    return True

def validate_volume_conservation(raw_df, agg_dict):
    """
    Validates that resampled volumes match raw trade volumes.
    """
    print("\n" + "="*80)
    print("STEP 2A: VOLUME CONSERVATION VALIDATION")
    print("="*80)
    
    raw_total_vol = raw_df['quantity'].sum()
    raw_buy_vol = raw_df['buy_vol'].sum()
    raw_sell_vol = raw_df['sell_vol'].sum()
    
    print(f"\n📊 Raw data totals:")
    print(f"  • Total volume: {raw_total_vol:,.2f}")
    print(f"  • Buy volume: {raw_buy_vol:,.2f}")
    print(f"  • Sell volume: {raw_sell_vol:,.2f}")
    
    for tf_name, agg_df in agg_dict.items():
        agg_total = agg_df['volume'].sum()
        agg_buy = agg_df['buy_vol'].sum()
        agg_sell = agg_df['sell_vol'].sum()
        
        # Calculate conservation percentage
        vol_conservation = (agg_total / raw_total_vol * 100) if raw_total_vol > 0 else 0
        buy_conservation = (agg_buy / raw_buy_vol * 100) if raw_buy_vol > 0 else 0
        sell_conservation = (agg_sell / raw_sell_vol * 100) if raw_sell_vol > 0 else 0
        
        # Check if within tolerance (99.9%)
        passed = all([
            99.9 <= vol_conservation <= 100.1,
            99.9 <= buy_conservation <= 100.1,
            99.9 <= sell_conservation <= 100.1
        ])
        
        status_symbol = "✅" if passed else "❌"
        print(f"\n{status_symbol} {tf_name} timeframe:")
        print(f"  • Total volume conservation: {vol_conservation:.3f}%")
        print(f"  • Buy volume conservation: {buy_conservation:.3f}%")
        print(f"  • Sell volume conservation: {sell_conservation:.3f}%")
        
        quality_report.metrics['volume_conservation'][tf_name] = {
            'passed': passed,
            'message': f"Conservation: {vol_conservation:.2f}%",
            'total_vol': vol_conservation,
            'buy_vol': buy_conservation,
            'sell_vol': sell_conservation
        }
        
        if not passed:
            quality_report.add_error(f"Volume not conserved in {tf_name} resampling")

def detect_low_confidence_bars(agg_df, timeframe_name):
    """
    Identifies bars with insufficient data for reliable analysis.
    """
    if 'trade_count' not in agg_df.columns:
        return agg_df
    
    low_conf = agg_df[agg_df['trade_count'] < MIN_TRADES_PER_BAR]
    
    if len(low_conf) > 0:
        quality_report.metrics['low_confidence_bars'] += len(low_conf)
        quality_report.add_warning(
            f"{timeframe_name}: {len(low_conf)} bars have <{MIN_TRADES_PER_BAR} trades"
        )
    
    # Add confidence flag
    agg_df['data_confidence'] = 'HIGH'
    agg_df.loc[agg_df['trade_count'] < MIN_TRADES_PER_BAR, 'data_confidence'] = 'LOW'
    agg_df.loc[agg_df['trade_count'] < MIN_TRADES_PER_BAR * 2, 'data_confidence'] = 'MEDIUM'
    
    return agg_df

